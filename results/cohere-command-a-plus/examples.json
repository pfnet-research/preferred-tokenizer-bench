ờ. Một câu khẳng định rộng có thể nghe nhiệt tình nhưng để hai bên tưởng hai việc khác nhau. Sự rõ ràng không làm lời mời kém thân thiện; nó giúp người đọc có lựa chọn thay vì chỉ có cảm giác được trấn an.","token_ids":[108693,27285,3650,195609,60632,12184,15925,34524,22899,53986,17665,10742,16469,36785,10955,36019,34723,18,150150,38581,22749,5398,26890,4757,36410,1002,16,12761,27285,14721,42259,14141,2681,52717,2579,8839,10906,21039,14548,31977,16641,18,34831,18398,10849,10906,15019,16,195609,7949,79733,25372,17665,7235,9610,22311,388,41930,79629,17949,16641,16,16641,52443,8613,22899,49778,9758,18952,42705,18,122950,2579,8839,10906,7949,4757,43461,9714,9600,7235,28018,12184,2681,79733,25372,16,6690,31857,39539,31857,10068,10659,4798,10955,56756,11399,5006,4360,17544,18,54501,16641,11108,12761,28957,14164,17686,7002,15728,16,9376,15102,14548,39539,31857,2681,41543,16084,13454,70641,18,47615,36019,87087,14081,41169,3245,6380,43819,53571,19498,15578,6690,17065,22749,40776,17065,10906,14791,22701,18,98583,34524,66076,4798,9610,31857,101049,77755,24570,44847,31,9282,16469,5771,56756,3245,31400,18200,29864,17389,10742,3245,20456,47269,4757,134182,387,18],"tokens":["ThÃ´ng","ĠbÃ¡o","Ġcá»§a","ĠxÆ°á»Łng","Ġsá»Ńa","ĠÄĳá»ĵ","ĠnÃ³i","ĠrÃµ","Ġáº£nh","Ġgá»Ńi","ĠtrÆ°á»Ľc","Ġchá»ī","ĠgiÃºp","Ġchuáº©n","Ġbá»ĭ","ĠcÃ¢u","Ġhá»ıi",".","ĠTÃ¬nh","Ġtráº¡ng","ĠbÃªn","Ġtrong","ĠchÆ°a","ĠÄĳÆ°á»£c","Ġkiá»ĥm","Ġtra",",","ĠnÃªn","ĠbÃ¡o","ĠgiÃ¡","Ġcuá»ĳi","ĠcÃ¹ng","ĠvÃł","Ġpháº¡m","Ġvi","ĠcÃ´ng","Ġviá»ĩc","Ġváº«n","Ġcáº§n","ĠxÃ¡c","ĠnháºŃn",".","ĠNáº¿u","Ġxuáº¥t","Ġhiá»ĩn","Ġviá»ĩc","Ġmá»Ľi",",","ĠxÆ°á»Łng","Ġsáº½","Ġtrao","ĠÄĳá»ķi","ĠtrÆ°á»Ľc","Ġkhi","ĠlÃłm","ĠthÃªm",".Ċ","Trong","Ġphiáº¿u","Ġtiáº¿p","ĠnháºŃn",",","ĠnháºŃn","ĠxÃ©t","Ġtá»«","Ġáº£nh","Ġnáº±m","Ġá»Ł","Ġpháº§n","ĠriÃªng",".","ĠPháº¡m","Ġvi","ĠcÃ´ng","Ġviá»ĩc","Ġsáº½","ĠÄĳÆ°á»£c","Ġghi","Ġláº¡i","Ġsau","Ġkhi","Ġxem","ĠÄĳá»ĵ","ĠvÃł","Ġtrao","ĠÄĳá»ķi",",","ĠÄĳá»ĥ","Ġlá»Ŀi","Ġtráº£","Ġlá»Ŀi","Ġban","ĠÄĳáº§u","ĠkhÃ´ng","Ġbá»ĭ","ĠÄĳá»įc"