" counts",");\n","}\n"],"ids_available":true,"boundaries_approximate":false,"piece_format":"native_vocabulary_piece","decoded_text":"// Count metal components in sorted key order. Converting each\n// quantity to a wider integer type before aggregation avoids a narrow per-\n// entry sum. Filtering above a threshold borrows the completed map and\n// leaves it unchanged. Map order is deterministic and does not depend on\n// randomized hash iteration.\n\nuse std::collections::BTreeMap;\n\nfn grouped_counts<'a>(items: &'a [(&'a str, u32)]) -> BTreeMap<&'a str, u64> {\n    let mut totals = BTreeMap::new();\n    for &(key, count) in items {\n        *totals.entry(key).or_insert(0) += u64::from(count);\n    }\n    totals\n}\nfn above_limit<'a>(counts: &BTreeMap<&'a str, u64>, limit: u64) -> Vec<(&'a str, u64)> {\n    counts.iter().filter_map(|(&key, &value)| {\n        if value > limit { Some((key, value)) } else { None }\n    }).collect()\n}\nfn main() {\n    let rows = [(\"copper\", 3), (\"zinc\", 0), (\"copper\", 5)];\n    let counts = grouped_counts(&rows);\n    assert_eq!(counts[\"copper\"], 8);\n    assert_eq!(above_limit(&counts, 4), vec![(\"copper\", 8)]);\n    assert!(grouped_counts(&[]).is_empty());\n    println!(\"{:?}\", counts);\n}\n","measurement_context":null,"character_measurement":null,"roundtrip_exact":true},{"id":"code-en-0003","collection":"dataset/code/en.jsonl","text":"# Choose a shortest sequence of doors through a gallery floor\n# plan. A predecessor table is also the visited set, preventing loops from\n# repeatedly entering the queue. Sorting neighbors establishes a\n# reproducible tie rule. A missing exit returns None, while starting at an\n# exit returns a one-element route.\n\nfrom collections import deque\n\ndef route_to_exit(graph, start, exits):\n    queue = deque([start])\n    parent = {start: None}\n    while queue:\n        node = queue.popleft()\n        if node in exits:\n            path = []\n            while node is not None:\n                path.append(node)\n                node = parent[node]\n            return path[::-1]\n        for neighbor in sorted(graph.get(node, ())):\n            if neighbor not in parent:\n                parent[neighbor] = node\n                queue.append(neighbor)\n    return None\n\nhall = {\"desk\": [\"door\", \"stairs\"], \"stairs\": [\"desk\", \"yard\"]}\nassert route_to_exit(hall, \"desk\", {\"yard\"}) == [\"desk\", \"stairs\", \"yard\"]\nassert route_to_exit(hall, \"door\", {\"yard\"}) is None\n","token_ids":[7,21941,265,46468,6917,302,18757,1257,265,27540,9544,203,7,2941,18,340,61097,2924,341,851,277,17398,867,16,19270,34198,499,203,7,27326,18140,277,14842,18,115190,26998,49001,265,203,7,90335,25661,6698,18,340,9546,10085,6714,4628,16,1706,6857,468,387,203,7,10085,6714,265,730,45312,9411,382,3161,19443,1250,107762,300,1847,9411,5912,46246,73890,16,1472,16,61899,2407,298,14842,351,107762,6336,6373,7204,298,3567,351,391,6373,30,4628,732,298,1706,14842,638,348,4572,351,14842,1248,183271,1653,348,592,4572,297,61899,638,454,2481,351,11210,454,1706,4572,341,516,4628,638,615,2481,6179,19392,465,615,4572,351,3567,62868,1391,454,758,2481,197901,21,1391,348,352,12156,297,19842,73890,1253,19392,16,146169,2407,454,592,12156,516,297,3567,638,615,3567,63,141867,65,351,4572,203,615,14842,6179,113757,31904,465,298,758,4628,300,47056,351,11595,69855,1023,8628,13281,728,373,49417,20873,373,49417,1023,8628,69855,728,373,25652,158547,5648,9411,5912,46246,11350,514,16,373,69855,728,11595,25652,170885,1377,8628,69855,728,373,49417,728,373,25652,11147,5648,9411,5912,46246,11350,514,16,373,13281,728,11595,25652,170885,341,4628,203],"tokens":["#","ĠChoose","Ġa","Ġshortest","Ġsequence","Ġof","Ġdoors","Ġthrough","Ġa","Ġgallery","Ġfloor","Ċ","#","Ġplan",".","ĠA","Ġpredecessor","Ġtable","Ġis","Ġalso","Ġthe","Ġvisited","Ġset",",","Ġpreventing","Ġloops","Ġfrom","Ċ","#","Ġrepeatedly","Ġentering","Ġthe","Ġqueue",".","ĠSorting","Ġneighbors","Ġestablishes","Ġa","Ċ","#","Ġreproducible","Ġtie","Ġrule",".","ĠA","Ġmissing","Ġexit","Ġreturns","ĠNone",",","Ġwhile","Ġstarting","Ġat","Ġan","Ċ","#","Ġexit","Ġreturns","Ġa","Ġone","-element","Ġroute",".ĊĊ","from","Ġcollections","Ġimport","Ġdeque","ĊĊ","def","Ġroute","_to","_exit","(graph",",","Ġstart",",","Ġexits","):Ċ","ĠĠĠ","Ġqueue","Ġ=","Ġdeque","([","start","])Ċ","ĠĠĠ","Ġparent","Ġ=","Ġ{","start",":","ĠNone","}Ċ","ĠĠĠ","Ġwhile","Ġqueue",":Ċ","ĠĠĠĠĠĠĠ","Ġnode","Ġ=","Ġqueue",".p","opleft","()Ċ","ĠĠĠĠĠĠĠ","Ġif","Ġnode","Ġin","Ġexits",":Ċ","ĠĠĠĠĠĠĠĠĠĠĠ","Ġpath","Ġ=","Ġ[]Ċ","ĠĠĠĠĠĠĠĠĠĠĠ","Ġwhile","Ġnode","Ġis","Ġnot","ĠNone",":Ċ","ĠĠĠĠĠĠĠĠĠĠĠĠĠĠĠ","Ġpath",".append","(node",")Ċ","ĠĠĠĠĠĠĠĠĠĠĠĠĠĠĠ","Ġnode","Ġ=","Ġparent","[node","]Ċ","ĠĠĠĠĠĠĠĠĠĠĠ","Ġreturn","Ġpath","[::-","1","]Ċ","ĠĠĠĠĠĠĠ","Ġfor","Ġneighbor","Ġin","Ġsorted","(graph",".get","(node",",","Ġ())","):Ċ","ĠĠĠĠĠĠĠĠĠĠĠ","Ġif","Ġneighbor","Ġnot","Ġin","Ġparent",":Ċ","ĠĠĠĠĠĠĠĠĠĠĠĠĠĠĠ","Ġparent","[","neighbor","]","Ġ=","Ġnode","Ċ","ĠĠĠĠĠĠĠĠĠĠĠĠĠĠĠ","Ġqueue",".append","(ne","ighbor",")Ċ","ĠĠĠ","Ġreturn","ĠNone","ĊĊ","hall","Ġ=","Ġ{\"","desk","\":","Ġ[\"","door","\",","Ġ\"","stairs","\"],","Ġ\"","stairs","\":","Ġ[\"","desk","\",","Ġ\"","yard","\"]}Ċ","assert","Ġroute","_to","_exit","(h","all",",","Ġ\"","desk","\",","Ġ{\"","yard","\"})","Ġ==","Ġ[\"","desk","\",","Ġ\"","stairs","\",","Ġ\"","yard","\"]Ċ","assert","Ġroute","_to","_exit","(h","all",",","Ġ\"","door","\",","Ġ{\"","yard","\"})","Ġis","ĠNone","Ċ"],"decoded_tokens":["#"," Choose"," a"," shortest"," sequence"," of"," doors"," through"," a"," gallery"," floor","\n","#"," plan","."," A"," predecessor"," table"," is"," also"," the"," visited"," set",","," preventing"," loops"," from","\n","#"," repeatedly"," entering"," the"," queue","."," Sorting"," neighbors"," establishes"," a","\n","#"," reproducible"," tie"," rule","."," A"," missing"," exit"," returns"," None",","," while"," starting"," at"," an","\n","#"," exit"," returns"," a"," one","-element"," route",".\n\n","from"," collections"," import"," deque","\n\n","def"," route","_to","_exit","(graph",","," start",","," exits","):\n","   "," queue"," ="," deque","([","start","])\n","   "," parent"," ="," {","start",":"," None","}\n","   "," while"," queue",":\n","       "," node"," ="," queue",".p","opleft","()\n","       "," if"," node"," in"," exits",":\n","           "," path"," ="," []\n","           "," while"," node"," is"," not"," None",":\n","               "," path",".append","(node",")\n","               "," node"," ="," parent","[node","]\n","           "," return"," path","[::-","1","]\n","       "," for"," neighbor"," in"," sorted","(graph",".get","(node",","," ())","):\n","           "," if"," neighbor"," not"," in"," parent",":\n","               "," parent","[","neighbor","]"," ="," node","\n","               "," queue",".append","(ne","ighbor",")\n","   "," return"," None","\n\n","hall"," ="," {\"","desk","\":"," [\"","door","\","," \"","stairs","\"],"," \"","stairs","\":"," [\"","desk","\","," \"","yard","\"]}\n","assert"," route","_to","_exit","(h","all",","," \"","desk","\","," {\"","yard","\"})"," =="," [\"","desk","\","," \"","stairs","\","," \"","yard","\"]\n","assert"," route","_to","_exit","(h","all",","," \"","door","\","," {\"","yard","\"})"," is"," None","\n"],"ids_available":true,"boundaries_approximate":false,"piece_format":"native_vocabulary_piece","decoded_text":"# Choose a shortest sequence of doors through a gallery floor\n# plan. A predecessor table is also the visited set, preventing loops from\n# repeatedly entering the queue. Sorting neighbors establishes a\n# reproducible tie rule. A missing exit returns None, while starting at an\n# exit returns a one-element route.\n\nfrom collections import deque\n\ndef route_to_exit(graph, start, exits):\n    queue = deque([start])\n    parent = {start: None}\n    while queue:\n        node = queue.popleft()\n        if node in exits:\n            path = []\n            while node is not None:\n                path.append(node)\n                node = parent[node]\n            return path[::-1]\n        for neighbor in sorted(graph.get(node, ())):\n            if neighbor not in parent:\n                parent[neighbor] = node\n                queue.append(neighbor)\n    return None\n\nhall = {\"desk\": [\"door\", \"stairs\"], \"stairs\": [\"desk\", \"yard\"]}\nassert route_to_exit(hall, \"desk\", {\"yard\"}) == [\"desk\", \"stairs\", \"yard\"]\nassert route_to_exit(hall, \"door\", {\"yard\"}) is None\n","measurement_context":null,"character_measurement":null,"roundtrip_exact":true},{"id":"code-ja-0025","collection":"dataset/code/ja.jsonl","text":"// 非負の辺重みを持つ小さなグラフで、始点からの最短距離を求める。未到達の距離に\n// は最大整数を使い、加算前にあふれを確認する。探索対象へ実際に到達した辺を検証\n// する実装なので、未到達部分の不正辺を全件検査する用途ではない。\n\npackage main\n\nimport \"fmt\"\n\ntype Edge struct { To int; Cost int }\nfunc cheapestPaths(graph [][]Edge, start int) ([]int, error) {\n    if start < 0 || start >= len(graph) { return nil, fmt.Errorf(\"bad start\") }\n    const infinity = int(^uint(0) >> 1)\n    distance := make([]int, len(graph))\n    used := make([]bool, len(graph))\n    for i := range distance { distance[i] = infinity }\n    distance[start] = 0\n    for range graph {\n        node := -1\n        for i := range graph { if !used[i] && (node < 0 || distance[i] < distance[node]) { node = i } }\n        if node < 0 || distance[node] == infinity { break }\n        used[node] = true\n        for _, edge := range graph[node] {\n            if edge.To < 0 || edge.To >= len(graph) || edge.Cost < 0 { return nil, fmt.Errorf(\"bad edge\") }\n            if edge.Cost <= infinity-distance[node] && distance[node]+edge.Cost < distance[edge.To] {\n                distance[edge.To] = distance[node]+edge.Cost\n            }\n        }\n    }\n    return distance, nil\n}\nfunc main() { result, err := cheapestPaths([][]Edge{{{1, 4}, {2, 9}}, {{2, 2}}, {}}, 0); fmt.Println(result, err) }\n","token_ids":[458,235824,37671,849,63267,6279,6281,78508,123623,177297,1187,830,11411,6390,43035,24