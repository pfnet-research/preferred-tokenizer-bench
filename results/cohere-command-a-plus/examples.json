a, poi alla riparazione improvvisata. Il gettone finì in una scatola con le fotografie del vecchio spazio. Non come cimelio importante, ma come piccolo promemoria. Sul nuovo inventario il leggio fu descritto con una riga semplice: completo, funzionante, da verificare soltanto dopo averlo appoggiato.","token_ids":[69154,1810,17399,80,10386,4730,50609,11638,3622,4837,186283,664,524,41457,810,364,2358,326,39193,7554,154784,18,120983,1505,52492,57763,1096,20460,16,93867,175381,3864,23802,45440,19733,12893,2179,18,6163,115306,1114,52686,19296,720,2253,35324,3874,364,10208,25590,105012,152257,6272,37802,18,29695,68776,4727,214701,720,967,35324,17309,7695,192814,33604,18,434,2402,1810,41457,810,21735,1722,25178,16,4530,297,15370,98042,18,330,15625,661,3349,8025,188323,297,19302,2179,524,133538,771,103095,16,102201,118941,621,11426,531,2358,16726,8725,1114,28207,93718,18,39015,606,26193,16,661,65928,2122,971,651,3864,19470,55470,18,6163,52686,9602,4730,47770,57926,30,621,17708,43900,93260,3891,616,226266,524,938,17122,1061,62958,237264,8143,77962,16,26650,8143,139571,4864,253193,576,18,6163,771,103095,1696,2402,297,2358,250667,364,484,73150,1114,133538,57918,18,9030,2423,180920,308,810,14702,16,4530,2423,70681,2648,345,7447,18,31170,33604,217374,1810,41457,810,11649,8777,121195,364,2358,205556,57500,30,44317,16,54842,2561,16,1700,147904,90352,22964,16299,773,253149,2179,18],"tokens":["Durante","Ġil","Ġtras","l","oco","Ġdella","Ġsala","Ġprove","ĠÃ¨","Ġri","appar","so","Ġun","Ġlegg","io","Ġcon","Ġuna","Ġg","amba","ĠpiÃ¹","Ġcorta",".","ĠTutti","Ġlo","Ġricord","avano","Ġinst","abile",",","Ġnessuno","Ġsape","va","ĠperchÃ©","Ġfosse","Ġstato","Ġconserv","ato",".","ĠIl","Ġdirettore","Ġdel","Ġgruppo","Ġpropose","Ġdi","Ġport","arlo","Ġvia","Ġcon","Ġgli","Ġaltri","Ġmobili","Ġinutil","izz","abili",".","ĠUna","Ġviolin","ista","Ġchiese","Ġdi","Ġprov","arlo","Ġprima","Ġsul","Ġpavimento","Ġnuovo",".","ĠL","Ã¬","Ġil","Ġlegg","io","Ġoscill","ava","Ġancora",",","Ġma","Ġin","Ġmodo","Ġdiverso",