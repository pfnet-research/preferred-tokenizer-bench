 цадахъ. Мацlазул батlи-батlиял даражабазул, мацlазул культураялъул-гьеб киналъулго буго кlудияб кlвар жамгlияталъул гlумруялъе».\n«Дунялалда буго 2500 ялдаса 6000 ялде щвезегlан мацl. гьезул мухlканаб къадар лъицаго абуларо, щайгурелъул цо мацlалда ва гьелъул диалекталда гьоркьоб батlалъиялъул гlурхъи чlезабизе кlолареб букlиналъ.","token_ids":[15053,446,2146,80,35392,11469,3765,80,47128,153268,47829,11056,405,2146,2381,17318,151566,943,1195,3765,943,28997,7570,430,35392,1806,15045,4331,13088,835,1668,4331,18527,18,9465,446,2146,80,2626,2054,80,446,2160,80,8639,80,3625,151566,943,18376,76469,80,737,2847,928,15846,3856,113241,4813,16,3765,943,15045,35392,11469,113200,11056,80,737,16441,172941,9104,12305,113200,11056,94093,206663,80,2381,17820,1657,943,1829,15045,4331,13088,835,1668,4331,18527,16,3765,943,15045,1657,54000,446,10165,20291,2847,36389,668,1402,2150,10557,430,1273,20389,884,2381,17318,472,3765,943,28997,7570,430,15762,1806,2235,4331,18527,10557,47829,11056,15973,1668,388,15053,446,2146,80,206663,8266,510,35392,11469,7020,6410,1806,80,472,10593,2381,4813,11056,47128,1473,17318,11469,16,2160,80,405,2146,46521,2235,3765,80,47128,153268,47829,9441,80,2381,473,80,28433,11056,47128,1473,17318,18,9465,446,2146,80,10557,47829,2626,2054,80,472,115759,2054,80,11597,668,1750,15302,2216,28997,10557,47829,16,54605,2146,80,10557,47829,65921,62807,113241,17318,47829,158223,943,15045,238024,2381,17318,47829,11469,35392,11469,1657,80,8051,11597,1668,1657,80,32066,7020,6410,1806,80,472,10593,2381,17318,47829,3765,80,18832,3856,113241,17318,430,23531,12459,13314,737,8494,668,2381,4813,35392,11469,225,22,2905,9104,668,4813,20291,225,26,937,9104,668,17820,28694,875,8948,6799,80,3857,54605,2146,80,18,3765,943,8948,47829,2105,20389,80,2894,181380,1657,17318,47128,542,4450,17318,204670,11469,4331,55751,3604,11065,16,28694,10309,28221,89731,17318,47829,11056,405,54605,2146,80,2381,4813,15888,3765,943,2235,17318,47829,28419,2381,126420,2381,4813,3765,943,2128,760,943,3450,2626,20