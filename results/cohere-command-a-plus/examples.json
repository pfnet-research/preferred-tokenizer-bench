}\n    return distance, nil\n}\nfunc main() { result, err := cheapestPaths([][]Edge{{{1, 4}, {2, 9}}, {{2, 2}}, {}}, 0); fmt.Println(result, err) }\n","measurement_context":null,"character_measurement":null,"roundtrip_exact":true},{"id":"code-ja-0042","collection":"dataset/code/ja.jsonl","text":"-- 同じ部屋の予約時間が重なる組を探す。半開区間として終端が次の開始と一致する場\n-- 合は衝突に含めない。識別子の大小を条件にして同じ組の逆順表示を防ぐ。後半の要\n-- 求時間総和は重複を含むので、実際の占有時間と呼ばない。\n\nCREATE TABLE reservations (id INTEGER PRIMARY KEY, room TEXT, begins INTEGER, ends INTEGER,\n CHECK (begins < ends));\nINSERT INTO reservations VALUES (1,'a',10,20),(2,'a',20,25),(3,'a',18,23),(4,'b',12,16),(5,'a',30,35);\nSELECT a.id AS earlier_id, b.id AS later_id, a.room,\n       MAX(a.begins,b.begins) AS overlap_start,\n       MIN(a.ends,b.ends) AS overlap_end\nFROM reservations AS a\nJOIN reservations AS b\n ON a.room = b.room AND a.id < b.id\n AND a.begins < b.ends AND b.begins < a.ends\nORDER BY a.id,b.id;\n\nWITH occupied AS (\n SELECT room, SUM(ends-begins) AS requested_duration, COUNT(*) AS requests\n FROM reservations GROUP BY room\n)\nSELECT room, requested_duration, requests FROM occupied ORDER BY room;\n","token_ids":[358,225,33749,75265,849,75496,109555,6279,35527,20776,221324,763,19225,12288,8273,8091,12261,27822,19447,1420,67361,51894,1298,68023,4069,7830,203,358,225,4268,1471,99945,23769,1179,17717,206075,763,219389,87221,61695,1422,27245,60611,33749,20776,849,46586,48379,19519,171315,763,164103,849,3249,203,358,225,9674,18279,44203,3277,1471,6279,47151,122087,7639,830,136246,200039,18279,241800,5186,19837,14758,8988,54971,344,318,40109,22358,10918,16,4508,30120,16,13590,40109,16,11751,40109,421,27598,344,55187,1153,460,11751,2692,7395,7041,54971,7997,344,21,5687,69,747,622,16,696,32959,22,5687,69,747,696,16,948,32959,23,5687,69,747,1045,16,1449,32959,24,5687,70,747,740,16,902,32959,25,5687,69,747,963,16,1773,450,10140,265,4636,5535,7977,1745,16,290,4636,5535,3735,1745,16,265,61739,421,1426,19375,6439,2427,895,1153,19230,2427,895,1153,13,5