an, 15huli ta kulapos an isip kan mga tawong ini; tinatahoban ninda an saindang mga talinga, pinipirong ninda an saindang mga mata, ta tibaad sinda makamaan, o makadangog, o makasabot, dangan magdolok sako nganing paomayan ko.’ 16”Alagad mga paladan kamo, huli ta an mga mata nindo nakakahiling; an mga talinga nindo nakakadangog!","token_ids":[807,50,3309,320,6647,2122,8644,16,4570,55,451,2904,10847,264,68241,86621,387,42740,29546,313,6610,77373,904,276,21763,170127,16,395,356,327,117436,2982,28744,18,225,740,44,9772,6377,387,134525,354,719,1609,11266,5718,16,113021,12541,4326,21763,98852,347,16,46881,291,420,456,105505,3819,2035,332,5718,18,1430,356,327,387,134525,354,719,1609,28744,16,204849,721,267,4326,8588,77,387,66146,28171,1609,14459,9976,227938,18,225,1068,47,5557,149613,387,46721,43884,279,12231,868,11185,88,1143,2904,117436,2982,1700,4242,6377,21849,3189,7279,307,11680,395,356,327,28744,10325,2624,14223,16,12040,51330,456,307,11680,395,356,327,28744,21849,45373,1191,456,283,9520,299,86621,276,18,225,992,47,5557,1609,2616,643,117436,2982,387,5029,17626,8121,2251,1269,299,30,13326,176924,627,14258,51330,456,307,17898,16,395,356,327,28744,9526,83,26294,113627,86621,31,50358,627,25998,3189,7279,307,17898,16,395,356,327,28744,9526,83,26294,417,44060,16,225,883,76,9772,6377,22012,55449,387,341,572,6610,42740,181880,627,3533,31,11108,93068,219415,307,11680,387,117436,244668,42740,262,4082,69,16,10515,572,368,627,307,11680,387,117436,244668,42740,30669,16,6377,82027,327,7504,69,26294,44060,16,283,26294,51330,456,16,283,26294,299,86621,16,282,5423,3819,141797,554,272,43167,307,1376,291,4326,313,32343,12231,47083,225,902,2883,2566,356,327,42740,6569,42899,9526,83,16,311,9772,6377,387,42740,30669,307,17898,22824,27000,7279,31,387,42740,262,4082,69,307,17898,22824,417,51330,456,5],"tokens":["11","N","ags","im","bag","Ġsi","ĠJesus",",","ĠâĢľ","S","ain","do","Ġip","in","apas","abot","Ġan","Ġmga","Ġhil","om","Ġkan","ĠKah","ade","an","Ġnin","Ġlangit",",","Ġal","ag","ad","Ġ