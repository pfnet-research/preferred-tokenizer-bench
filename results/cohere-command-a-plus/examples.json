4::from(count);\n    }\n    totals\n}\nfn above_limit<'a>(counts: &BTreeMap<&'a str, u64>, limit: u64) -> Vec<(&'a str, u64)> {\n    counts.iter().filter_map(|(&key, &value)| {\n        if value > limit { Some((key, value)) } else { None }\n    }).collect()\n}\nfn main() {\n    let rows = [(\"copper\", 3), (\"zinc\", 0), (\"copper\", 5)];\n    let counts = grouped_counts(&rows);\n    assert_eq!(counts[\"copper\"], 8);\n    assert_eq!(above_limit(&counts, 4), vec![(\"copper\", 8)]);\n    assert!(grouped_counts(&[]).is_empty());\n    println!(\"{:?}\", counts);\n}\n","token_ids":[458,4716,7715,5721,297,19842,1993,1991,18,143635,1450,203,458,13245,304,265,19719,11795,1351,1714,40096,58317,265,14522,621,6071,458,6920,4455,18,121741,2946,265,11960,202693,277,8809,4400,306,203,458,9643,411,38750,18,9729,1991,341,57272,306,1414,516,5086,366,203,458,33424,11924,29607,382,826,3619,736,60088,736,207699,4071,630,13943,38340,65935,20025,69,5459,5625,30,44594,69,648,253163,69,1284,16,493,1028,134727,2649,158227,4071,158495,69,1284,16,493,1507,34,449,298,1529,4672,75300,351,158227,4071,736,1815,1133,298,352,71380,2311,16,1682,13,297,4551,449,348,535,244236,52337,13317,680,273,48783,12,20,13,4284,493,1507,736,3161,38460,450,298,706,298,75300,203,732,13943,2946,38149,20025,69,5459,118107,30,764,207699,4071,158495,69,1284,16,493,1507,12224,4753,30,493,1507,13,2649,19264,32,253163,69,1284,16,493,1507,35059,449,298,19720,31805,2338,12193,14008,21914,4293,2311,16,764,1988,9522,449,348,592,1333,1518,4753,391,4195,2091,2311,16,1333,1149,452,1625,391,4628,706,298,23363,23448,1653,732,13943,1584,581,449,298,1529,12462,351,238698,202812,728,225,23,733,7244,94,2531,728,225,20,733,7244,202812,728,225,25,74214,298,1529,19720,351,38340,65935,4293,3684,450,298,3999,17991,11277,118107,3246,202812,20873,225,28,450,298,3999,17991,11277,48218,38149,4293,118107,16,225,24,733,12649,7924,711,202812,728,225,28,164112,298,3999,11277,213936,65935,4293,3193,680,280,36259,3729,298,26476,181815,19720,450,732