리를 재고 나니 책상보다 의자를 뒤로 뺄 공간이 문제였다.\n결국 구매를 포기한다고 연락했다. 판매자는 괜찮다며, 다른 물건을 볼 때도 다리 사이의 폭을 확인하라고 알려 주었다. 물건을 사지는 않았지만 필요한 치수를 적은 종이는 남았다. 다음 주에는 그 종이를 들고 동네 재사용 가게에 가 볼 생각이다. 가격표를 보기 전에 생활 속에서 실제로 쓸 수 있는지부터 살피려 한다. 사진의 넓은 방과 내 방의 동선은 같지 않으니까.","token_ids":[13068,1980,14451,6884,4303,68848,32682,37916,65048,8292,18,43370,15069,21236,259,20338,1211,72413,10259,154011,44993,30580,8256,2460,76288,91568,241829,150723,145662,88907,3547,64820,7249,13857,18,48283,206874,145381,90747,157345,38384,27931,4824,43370,6626,14451,1211,13750,216507,16618,8292,18,161418,57536,1579,149168,15614,1980,8451,7286,32682,5269,27931,10755,39574,214181,212718,231,245296,24679,27314,388,17343,6675,46010,2386,149379,73015,85385,8292,18,44993,30580,124236,1183,7578,16,23895,19543,128047,38975,188317,214588,177323,50259,1579,27854,1601,24874,45403,7249,13857,18,19543,128047,4068,28618,56663,12387,51216,25706,51915,157345,24023,37207,19189,29025,18,32650,7249,15069,4824,24023,65608,141653,208082,15614,76878,165179,1491,5043,38975,21468,9354,18,42500,142682,81390,66907,57157,110907,92825,119078,3848,103258,16372,24255,19448,9179,24235,18,43370,1727,181196,11072,4145,9816,11072,1727,12363,218284,14608,2181,157550,30915,18],"tokens":["ì¤ĳ","ê³ł","Ġìŀ¥","íĦ°","ìĹĲìĦľ","ĠìŀĳìĿĢ","Ġì±ħ","ìĥģìĿĦ","Ġë°ľê²¬","íĸĪëĭ¤",".","ĠìĤ¬ì§Ħ","ìĹĲëĬĶ","ĠíĿ","ł","ì§ĳ","ìĿ´","Ġê±°ìĿĺ","ĠìĹĨ","ìĹĪì§Ģë§Į","ĠíĮĲë§¤","ìŀĲëĬĶ","Ġëª¨","ìĦľ","ë¦¬ìĿĺ","Ġë²Ĺ","ê²¨ì§Ħ","Ġë¶Ģë¶ĦìĿĦ","ĠëĶ°ë¡ľ","Ġì°į","ìĸ´","Ġë³´ëĤ´","Ġì£¼","ìĹĪëĭ¤",".","Ġë§ī","ìĹ°íŀĪ","Ġê¹¨ëģĹ","íķĺëĭ¤ê³ł","ĠìłģìĿĢ","ĠìĦ¤ëªħ","ë³´ëĭ¤","Ġê·¸","ĠìĤ¬ì§Ħ","Ġíķľ","Ġìŀ¥","ìĿ´","ĠëįĶ","Ġë¯¿ìĿĮ","ì§ģ","íĸĪëĭ¤",".","Ġì§ĳìĹĲ","ĠëĨĵ","ìĿĦ","ĠìŀĲë¦¬ë¥¼","Ġìŀ¬","ê³ł","ĠëĤĺ","ëĭĪ","Ġì±ħ","ìĥģ","ë³´ëĭ¤","ĠìĿĺ","ìŀĲë¥¼","ĠëĴ¤ë¡ľ","Ġëº","Ħ","Ġê³µê°ĦìĿ´","Ġë¬¸ìłľ","ìĺĢëĭ¤",".Ċ","ê²°","êµŃ","Ġêµ¬ë§¤","ë¥¼","Ġíı¬ê¸°","íķľëĭ¤ê³ł","ĠìĹ°ëĿ½","íĸĪëĭ¤",".","ĠíĮĲë§¤","ìŀĲëĬĶ","Ġê´ľì°®","ëĭ¤","ë©°",",","Ġëĭ¤ë¥¸","Ġë¬¼","ê±´ìĿĦ","Ġë³¼","ĠëķĮëıĦ","Ġëĭ¤ë¦¬","ĠìĤ¬ìĿ´ìĿĺ","ĠíıŃ","ìĿĦ","ĠíĻķìĿ¸","íķĺ"