ిమా చేయబోతున్నాడని వినికిడి. వివరాల్లోకెళ్తే.. `కుమారి 21 ఎఫ్` డైరెక్టర్ సూర్య ప్రతాప్తో నితిన్ హీరోగా సుకుమార్ రైటింగ్స్, గీతాఆర్ట్స్ కలయికలో సినిమా చేయాల్సి ఉంది. ఆ సినిమా వాయిదా పడుతూ వస్తుంది. ప్రస్తుతం వెంకీ కుడుమల దర్శకత్వంలో నటిస్తోన్న నితిన్ ఆ సినిమా తర్వాత సుకుమార్ నిర్మాణంలో సినిమా ఉంటుంది. అయితే.. ఇప్పుడు ఈ ప్రాజెక్ట్లో గీతాఆర్ట్స్ భాగస్వామ్యం కావడం లేదట.","token_ids":[30981,203410,63434,22548,41037,155055,220312,31552,247480,161700,89345,12704,26330,4297,80820,220312,125538,71213,138919,70733,82289,100959,27961,54454,80254,177185,115436,109947,18,46289,30981,12813,82289,100959,27961,54454,80254,53406,13034,22548,41037,155055,220312,29867,53406,32078,28955,13034,179523,245250,117310,71641,189974,52894,119285,44255,21022,32078,32562,7267,187691,18,230553,12704,215468,17290,19591,91032,28955,12813,568,1411,17290,155055,221126,225,1710,53456,172187,4297,68,100728,33859,12704,186489,33462,67098,22548,116418,27682,166315,114227,28955,13034,29867,53406,32078,4297,85164,135158,13034,111645,22548,41037,155055,220312,36705,33859,29548,127175,111530,16,54107,16591,26330,6646,233,12704,33462,111530,138795,32965,32562,74679,245250,117310,26950,57611,5140,217342,18,41697,245250,21022,52017,171587,5698,18126,30051,57804,73926,240492,86843,18,40413,118926,57804,24409,126542,183657,16591,19914,138948,155055,15695,49412,197932,17290,26330,54454,70733,29867,29548,86008,13034,49863,29867,53406,32078,4297,41697,245250,31552,171476,72348,22548,41037,155055,220312,125538,71213,138919,70733,245250,151133,86843,18,237570,568,46289,175223,67924,40413,99964,186489,33462,74521,54107,16591,26330,6646,233,12704,33462,111530,82289,100959,27961,54454,80254,207348,19914,88586,121122,156479,29548,18],"tokens":["à°¦","à±Ģà°¨","à°¿à°ķà°¿","Ġà°¸","à±ģà°ķ","à±ģà°®","à°¾à°°à±į","Ġà°¤","à±ĭà°¡","à±ģà°Ĺà°¾","Ġà°¶","à°°","à°¤","à±į","Ġà°®à°°","à°¾à°°à±į","Ġà°¨à°¿à°°","à±įà°®","à°¾à°£","à°Ĥà°²à±ĭ","Ġà°Ń","à°¾à°Ĺ","à°¸","à±įà°µ","à°¾à°®","à°¿à°Ĺà°¾","Ġà°īà°¨à±įà°¨","à°¾à°¡à±ģ",".","Ġà°ĩ","à°¦","à±