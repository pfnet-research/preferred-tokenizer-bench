okwakha nokuhlinzeka ngezinhlelo ezahlukahlukene zokubambisana ngokwezidingo zamakhasimende. Le modeli yenzelwe ukusiza amakhasimende ukuxazulula izinkinga ezihlangabezane ne-R & D nokukhiqiza nokunikeza amakhasimende izixazululo ezenziwe ngezifiso ezifanelekela kangcono ukuthuthukiswa kwesikhathi esizayo.\nE-China (Shanghai) International Technology Fair kulo nyaka, i-TIANGEN ayivelanga nje kuphela i-high-throughput othomathikhi ye-nucleic acid extractors kanye ne-auto pipetting workstation kepha nemikhiqizo esebenza kabusha kanye nezinto zokusetshenziswa zohlolo lwe-SARS-COV2, oludonse amabhizinisi asekhaya nakwamanye amazwe e-IVD e-Fair ukuxhumana.","token_ids":[40,9469,40,5330,965,304,564,12825,5317,268,906,41986,6292,30625,336,6577,13637,2995,391,383,26738,597,906,88,819,25330,27955,3178,82649,5797,72,19185,71,78071,13532,514,12,3166,35,7933,336,31559,90777,392,3042,285,3444,3999,287,80,352,450,535,273,31469,2194,76876,458,597,372,587,4752,318,11178,25470,71,78071,13532,13,358,339,318,4749,514,89,1354,450,587,12812,384,8510,80,11251,4385,72,906,326,450,437,2234,360,10196,7933,564,12825,5317,276,10994,671,1494,14559,387,11151,612,423,11,18393,1412,86,752,17082,383,597,49383,44964,299,73,1247,339,72,90777,86,587,4317,80833,12825,3817,89,53413,308,713,89,21538,273,385,44420,17137,3178,17137,3178,1994,1167,564,392,3042,285,3444,7933,564,906,89,6714,78,61576,587,4752,318,11178,13,2009,1646,72,379,17007,301,906,15012,355,17528,1097,587,4752,318,11178,15012,2249,1394,360,5724,22924,16113,64,44420,7141,5317,84578,2194,841,11151,612,423,80833,3178,6151,80,17528,80833,359,3043,4458,1097,587,4752,318,11178,22924,953,1394,360,8938,384,5797,8510,906,308,713,89,333,15782,44420,333,2194,76876,8458,99386,86958,15012,952,952,3178,68320,30625,288,31603,67631,1560,450,77080,627,36,98709,320,2059,31170,8,7327,12053,14930,597,8938,19541,13637,11,602,9469,40,5330,965,19432,21169,19934,308,3841,81808,71,8458,602,28661,43847,631,297,339,316,589,1609,6151,20043,5392,22935,292,13935,881