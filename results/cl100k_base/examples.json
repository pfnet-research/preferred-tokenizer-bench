ра за присъединяване на България към Европейския съюз“, заяви от своя страна Караянчева.\nОтбелязахме доброто сътрудничество в сферата на културата и образованието, допълни тя.\nПредседателят на Камарата на представителите на Република Кипър Димитрис Силурис отбеляза, че трябва традиционните отлични отношения между Кипър и България да бъдат реализирани на практика и приложени в полза на двата народа. Ние изпитваме голяма благодарност към България за времето след турската инвазия, когато България даде работа и хляб на хиляди кипърски граждани, изгубили домовете си, посочи той.","token_ids":[56163,27435,12507,19190,1840,22911,10693,6578,1532,7952,14082,2233,27055,29619,9542,81301,17165,20879,13999,12426,18999,11,88515,9542,1482,48835,24697,1532,12561,32985,25756,9706,19479,27055,13,64571,3114,34493,9706,17721,67745,11562,3865,44946,11047,6856,1506,11,17756,1532,36479,48445,34694,2233,14391,47067,1532,22918,7094,14525,20879,5173,34694,2233,5591,27055,7952,34694,2233,17394,18226,1840,11,88515,9542,1482,18600,8131,62809,1840,15458,22911,7952,14837,6856,9239,1506,44946,12561,13810,34694,13404,19479,4329,5591,7486,1532,13373,64571,34694,3114,15752,17721,40231,7820,34694,6578,60376,5591,2233,29256,21708,80112,4329,5524,34694,12182,9136,51786,11122,36497,5591,1840,20879,45916,61390,30392,7486,1506,36479,17721,36497,2156,6148,33742,1506,627,60627,10124,44100,9136,1506,10693,6578,1532,7952,14082,2233,13337,1482,5524,34694,1830,20346,7094,23446,6148,52744,5927,5524,19916,7753,43203,13373,7820,3865,3114,1830,56515,43203,7740,21923,89554,6856,14332,8341,1482,11,7952,29256,34694,3114,23446,11047,4329,627,17279,44075,2297,13404,8131,44100,1830,13373,36479,24697,17721,43203,13373,57925,68374,9542,12394,27055,13373,49520,67124,64569,11320,13433,36479,48445,34694,2233,39903,16494,9542,2233,13810,28599,64292,56515,13810,20879,10124,44100,9136,1506,11,17756,1532,86995,4329,10124,94538,11047,11001,112,1840,15458,17766,2156,27055,20879,91216,23446,20879,13999,12426,18999,11562,50436,7094,