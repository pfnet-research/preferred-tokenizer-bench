h a gallery floor\n# plan. A predecessor table is also the visited set, preventing loops from\n# repeatedly entering the queue. Sorting neighbors establishes a\n# reproducible tie rule. A missing exit returns None, while starting at an\n# exit returns a one-element route.\n\nfrom collections import deque\n\ndef route_to_exit(graph, start, exits):\n    queue = deque([start])\n    parent = {start: None}\n    while queue:\n        node = queue.popleft()\n        if node in exits:\n            path = []\n            while node is not None:\n                path.append(node)\n                node = parent[node]\n            return path[::-1]\n        for neighbor in sorted(graph.get(node, ())):\n            if neighbor not in parent:\n                parent[neighbor] = node\n                queue.append(neighbor)\n    return None\n\nhall = {\"desk\": [\"door\", \"stairs\"], \"stairs\": [\"desk\", \"yard\"]}\nassert route_to_exit(hall, \"desk\", {\"yard\"}) == [\"desk\", \"stairs\", \"yard\"]\nassert route_to_exit(hall, \"door\", {\"yard\"}) is None\n","token_ids":[2,22991,264,40243,8668,315,14365,1555,264,18537,6558,198,2,3197,13,362,40274,2007,374,1101,279,12263,743,11,27252,30853,505,198,2,19352,16661,279,7325,13,78243,19228,64664,264,198,2,53823,79385,18623,6037,13,362,7554,4974,4780,2290,11,1418,6041,520,459,198,2,4974,4780,264,832,29552,6149,382,1527,15661,1179,43050,271,755,6149,2401,17305,25301,11,1212,11,43186,997,262,7325,284,43050,2625,2527,2608,262,2748,284,314,2527,25,2290,534,262,1418,7325,512,286,2494,284,7325,558,77352,746,286,422,2494,304,43186,512,310,1853,284,4260,310,1418,2494,374,539,2290,512,394,1853,2102,7103,340,394,2494,284,2748,30997,933,310,471,1853,63254,16,933,286,369,9760,304,10839,25301,673,7103,11,45581,997,310,422,9760,539,304,2748,512,394,2748,58,37569,60,284,2494,198,394,7325,2102,7,37569,340,262,471,2290,271,43341,284,5324,51169,794,4482,11020,498,330,31234,8073,330,31234,794,4482,51169,498,330,17884,93110,2256,6149,2401,17305,3283,543,