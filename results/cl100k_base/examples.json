 SOH-prefix count stripping, a different context.","character_measurement":{"prefix":"U+0001","prefix_token_count":1,"prefixed_token_count":4,"measured_token_count":3,"prefix_stable":true},"roundtrip_exact":true},{"id":"characters-jis-l2-1023","collection":"dataset/characters/jis_l2.jsonl","text":"慴","token_ids":[162,227,112],"tokens":["e6","85","b4"],"decoded_tokens":["�","�","�"],"ids_available":true,"boundaries_approximate":false,"piece_format":"hex_bytes","decoded_text":"慴","measurement_context":"Standalone encode(text); character_coverage uses legacy SOH-prefix count stripping, a different context.","character_measurement":{"prefix":"U+0001","prefix_token_count":1,"prefixed_token_count":4,"measured_token_count":3,"prefix_stable":true},"roundtrip_exact":true},{"id":"code-en-0031","collection":"dataset/code/en.jsonl","text":"// Count metal components in sorted key order. Converting each\n// quantity to a wider integer type before aggregation avoids a narrow per-\n// entry sum. Filtering above a threshold borrows the completed map and\n// leaves it unchanged. Map order is deterministic and does not depend on\n// randomized hash iteration.\n\nuse std::collections::BTreeMap;\n\nfn grouped_counts<'a>(items: &'a [(&'a str, u32)]) -> BTreeMap<&'a str, u64> {\n    let mut totals = BTreeMap::new();\n    for &(key, count) in items {\n        *totals.entry(key).or_insert(0) += u64::from(count);\n    }\n    totals\n}\nfn above_limit<'a>(counts: &BTreeMap<&'a str, u64>, limit: u64) -> Vec<(&'a str, u64)> {\n    counts.iter().filter_map(|(&key, &value)| {\n        if value > limit { Some((key, value)) } else { None }\n    }).collect()\n}\nfn main() {\n    let rows = [(\"copper\", 3), (\"zinc\", 0), (\"copper\", 5)];\n    let counts = grouped_counts(&rows);\n    assert_eq!(counts[\"copper\"], 8);\n    assert_eq!(above_limit(&counts, 4), vec![(\"copper\", 8)]);\n    assert!(grouped_counts(&[]).is_empty());\n    println!(\"{:?}\", counts);\n}\n","token_ids":[322,4605,9501,6956,3