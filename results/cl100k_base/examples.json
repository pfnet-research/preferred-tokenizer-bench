dge",".C","ost"," <"," distance","[edge",".To","]"," {\n","               "," distance","[edge",".To","]"," ="," distance","[node","]+","edge",".C","ost","\n","           "," }\n","       "," }\n","   "," }\n","   "," return"," distance",","," nil","\n","}\n","func"," main","()"," {"," result",","," err"," :="," cheapest","Paths","([]","[]","Edge","{{{","1",","," ","4","},"," {","2",","," ","9","}},"," {{","2",","," ","2","}},"," {}","},"," ","0",");"," fmt",".Println","(result",","," err",")"," }\n"],"ids_available":true,"boundaries_approximate":false,"piece_format":"hex_bytes","decoded_text":"// 非負の辺重みを持つ小さなグラフで、始点からの最短距離を求める。未到達の距離に\n// は最大整数を使い、加算前にあふれを確認する。探索対象へ実際に到達した辺を検証\n// する実装なので、未到達部分の不正辺を全件検査する用途ではない。\n\npackage main\n\nimport \"fmt\"\n\ntype Edge struct { To int; Cost int }\nfunc cheapestPaths(graph [][]Edge, start int) ([]int, error) {\n    if start < 0 || start >= len(graph) { return nil, fmt.Errorf(\"bad start\") }\n    const infinity = int(^uint(0) >> 1)\n    distance := make([]int, len(graph))\n    used := make([]bool, len(graph))\n    for i := range distance { distance[i] = infinity }\n    distance[start] = 0\n    for range graph {\n        node := -1\n        for i := range graph { if !used[i] && (node < 0 || distance[i] < distance[node]) { node = i } }\n        if node < 0 || distance[node] == infinity { break }\n        used[node] = true\n        for _, edge := range graph[node] {\n            if edge.To < 0 || edge.To >= len(graph) || edge.Cost < 0 { return nil, fmt.Errorf(\"bad edge\") }\n            if edge.Cost <= infinity-distance[node] && distance[node]+edge.Cost < distance[edge.To] {\n                distance[edge.To] = distance[node]+edge.Cost\n            }\n        }\n    }\n    return distance, nil\n}\nfunc main() { result, err := cheapestPaths([][]Edge{{{1, 4}, {2, 9}}, {{2, 2}}, {}}, 0); fmt.Println(result, err) }\n","measurement_context":null,"character_measurement":null,"roundtrip_exact":true},{"id":"code-ja-0042","collection":"dataset/code/ja.jsonl","text":"-- 同じ部屋の予約時間が重なる組を探す。半開区間として終端が次の開始と一致する場\n-- 合は衝突に含めない。識別子の大小を条件にして同じ組の逆順表示を防ぐ。後半の要\n-- 求時間総和は重複を含むので、実際の占有時間と呼ばない。\n\nCREATE TABLE reservations (id INTEGER PRIMARY KEY, room TEXT, begins INTEGER, ends INTEGER,\n CHECK (begins < ends));\nINSERT INTO reservations VALUES (1,'a',10,20),(2,'a',20,25),(3,'a',18,23),(4,'b',12,16),(5,'a',30,35);\nSELECT a.id AS earlier_id, b.id AS later_id, a.room,\n       MAX(a.begins,b.begins) AS overlap_start,\n       MIN(a.ends,b.ends) AS overlap_end\nFROM reservations AS a\nJOIN reservations AS b\n ON a.room = b.room AND a.id < b.id\n AND a.begins < b.ends AND b.begins < a.ends\nORDER BY a.id,b.id;\n\nWITH occupied AS (\n SELECT room, SUM(ends-begins) AS requested_duration, COUNT(*) AS requests\n FROM reservations GROUP BY room\n)\nSELECT room, requested_duration, requests FROM occupied ORDER BY room;\n","token_ids":[313,39533,234,100204,34048,23602,233,16144,6823,230,27869,226,82973,29295,30358,26854,30369,58254,226,30512,19012,95,17663,1811,11239,232,87447,24775,56965,19732,39926,58254,224,79982,29295,33671,16144,87447,27704,19732,15120,26274,112,54926,75267,198,313,39533,230,15682,13079,251,91739,223,20230,96412,62004,26854,16995,1811,92148,246,6701,98,45829,16144,93132,30512,77195,20230,39926,42016,100204,58254,226,16144,11589,228,80988,228,52563,30512,33443,110,2243,238,1811,74482,11239,232,16144,31634,198,313,6704,109,224,82973,163,115,237,34208,15682,30358,164,97,229,30512,96412,3484,222,16144,16556,5486,8676,253,37795,249,16144,11239,254,19361,82973,19732,17857,120,81219,26854,16995,3490,23421,14700,41162,320,307,31481,38567,12282,11,3130,16139,11,12302,31481,11,10548,31481,345,13958,320,52253,1354,366,10548,1125,12987,12779,41162,15052,320,16,2965,64,518,605,11,508,24457,17,2965,64,518,508,11,914,24457,18,2965,64,518,972,11,1419,24457,19,2965,65,518,717,11,845,24457,20,2965,64,518,966,11,1758,317,4963,264,1801,5871,6931,851,11,293,1801,5871,3010,851,11,264,22788,345,996,8498,2948,960,797,1354,85