64","286772617068","2e676574","286e6f6465","2c","20282929","293a0a","2020202020202020202020","206966","206e65696768626f72","206e6f74","20696e","20706172656e74","3a0a","202020202020202020202020202020","20706172656e74","5b","6e65696768626f72","5d","203d","206e6f6465","0a","202020202020202020202020202020","207175657565","2e617070656e64","28","6e65696768626f72","290a","202020","2072657475726e","204e6f6e65","0a0a","68616c6c","203d","207b22","6465736b","223a","205b22","646f6f72","222c","2022","737461697273","225d2c","2022","737461697273","223a","205b22","6465736b","222c","2022","79617264","225d7d0a","617373657274","20726f757465","5f746f","5f65786974","2868","616c6c","2c","2022","6465736b","222c","207b22","79617264","227d29","203d3d","205b22","6465736b","222c","2022","737461697273","222c","2022","79617264","225d0a","617373657274","20726f757465","5f746f","5f65786974","2868","616c6c","2c","2022","646f6f72","222c","207b22","79617264","227d29","206973","204e6f6e65","0a"],"decoded_tokens":["#"," Choose"," a"," shortest"," sequence"," of"," doors"," through"," a"," gallery"," floor","\n","#"," plan","."," A"," predecessor"," table"," is"," also"," the"," visited"," set",","," preventing"," loops"," from","\n","#"," repeatedly"," entering"," the"," queue","."," Sorting"," neighbors"," establishes"," a","\n","#"," repro","ducible"," tie"," rule","."," A"," missing"," exit"," returns"," None",","," while"," starting"," at"," an","\n","#"," exit"," returns"," a"," one","-element"," route",".\n\n","from"," collections"," import"," deque","\n\n","def"," route","_to","_exit","(graph",","," start",","," exits","):\n","   "," queue"," ="," deque","([","start","])\n","   "," parent"," ="," {","start",":"," None","}\n","   "," while"," queue",":\n","       "," node"," ="," queue",".p","opleft","()\n","       "," if"," node"," in"," exits",":\n","           "," path"," ="," []\n","           "," while"," node"," is"," not"," None",":\n","               "," path",".append","(node",")\n","               "," node"," ="," parent","[node","]\n","           "," return"," path","[::-","1","]\n","       "," for"," neighbor"," in"," sorted","(graph",".get","(node",","," ())","):\n","           "," if"," neighbor"," not"," in"," parent",":\n","               "," parent","[","neighbor","]"," ="," node","\n","               "," queue",".append","(","neighbor",")\n","   "," return"," None","\n\n","hall"," ="," {\"","desk","\":"," [\"","door","\","," \"","stairs","\"],"," \"","stairs","\":"," [\"","desk","\","," \"","yard","\"]}\n","assert"," route","_to","_exit","(h","all",","," \"","desk","\","," {\"","yard","\"})"," =="," [\"","desk","\","," \"","stairs","\","," \"","yard","\"]\n","assert"," route","_to","_exit","(h","all",","," \"","door","\","," {\"","yard","\"})"," is"," None","\n"],"ids_available":true,"boundaries_approximate":false,"piece_format":"hex_bytes","decoded_text":"# Choose a shortest sequence of doors through a gallery floor\n# plan. A predecessor table is also the visited set, preventing loops from\n# repeatedly entering the queue. Sorting neighbors establishes a\n# reproducible tie rule. A missing exit returns None, while starting at an\n# exit returns a one-element route.\n\nfrom collections import deque\n\ndef route_to_exit(graph, start, exits):\n    queue = deque([start])\n    parent = {start: None}\n    while queue:\n        node = queue.popleft()\n        if node in exits:\n            path = []\n            while node is not None:\n                path.append(node)\n                node = parent[node]\n            return path[::-1]\n        for neighbor in sorted(graph.get(node, ())):\n            if neighbor not in parent:\n                parent[neighbor] = node\n                queue.append(neighbor)\n    return None\n\nhall = {\"desk\": [\"door\", \"stairs\"], \"stairs\": [\"desk\", \"yard\"]}\nassert route_to_exit(hall, \"desk\", {\"yard\"}) == [\"desk\", \"stairs\", \"yard\"]\nassert route_to_exit(hall, \"door\", {\"yard\"}) is None\n","measurement_context":null,"character_measurement":null,"roundtrip_exact":true},{"id":"code-ja-0025","collection":"dataset/code/ja.jsonl","text":"// 非負の辺重みを持つ小さなグラフで、始点からの最短距離を求める。未到達の距離に\n// は最大整数を使い、加算前にあふれを確認する。探索対象へ実際に到達した辺を検証\n// する実装なので、未到達部分の不正辺を全件検査する用途ではない。\n\npackage main\n\nimport \"fmt\"\n\ntype Edge struct { To int; Cost int }\nfunc cheapestPaths(graph [][]Edge, start int) ([]int, error) {\n    if start < 0 || start >= len(graph) { return nil, fmt.Errorf(\"bad start\") }\n    const infinity = int(^uint(0) >> 1)\n    distance := make([]int, len(graph))\n    used := make([]bool, len(graph))\n    for i := range distance { distance[i] = infinity }\n    distance[start] = 0\n    for range graph {\n        node := -1\n        for i := range graph { if !used[i] && (node < 0 || distance[i] < distance[node]) { node = i } }\n        if node < 0 || distance[node] == infinity { break }\n        used[node] = true\n        for _, edge := range graph[node] {\n            if edge.To < 0 || edge.To >= len(graph) || edge.Cost < 0 { return nil, fmt.Errorf(\"bad edge\") }\n            if edge.Cost <= infinity-distance[node] && distance[node]+edge.Cost < distance[edge.To] {\n                distance[edge.To] = distance[node]+edge.Cost\n            }\n        }\n    }\n    return distance, nil\n}\nfunc main() { result, err := cheapestPaths([][]Edge{{{1, 4}, {2, 9}}, {{2, 2}}, {}}, 0); fmt.Println(result, err) }\n","token_ids":[322,18630,251,252,80631,254,16144,16205,118,30358,64121,30512,69978,59739,31809,30813,26854,41758,32131,52591,16556,5486,27704,28542,55031,16144,32335,163,253,255,36596,251,25132,95,30512,32018,62004,30369,1811,39442,28037,30250,242,16144,36596,251,25132,95,20230,198,322,220,15682,32335,27384,64531,9039,30512,33655,16995,5486,21601,70203,25580,20230,30591,2243,113,33121,30512,81802,118,45918,235,54926,1811,19012,95,52084,15973,122,47523,2243,116,8676,253,37795,249,20230,28037,30250,242,56051,16205,118,30512,162,97,250,29245,120,198,322,220,54926,8676