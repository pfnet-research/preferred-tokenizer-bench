ang tu pun. Huhu.... Bukanlah maknanya aku ni tak prihatin or tak ada perasaan ke apa, just aku tak sukalah situasi macam tu.","token_ids":[4516,503,19148,15342,1048,266,296,26261,11163,1216,4864,409,857,50707,78410,275,9964,13728,1131,92941,452,526,285,8474,36454,2933,712,74890,503,19148,0,5112,5347,17243,18757,300,23200,587,15342,41986,281,9832,3178,3289,1609,62150,1043,12874,503,19148,11163,1216,482,11163,1216,99176,18608,296,19818,281,9832,3178,13,34390,32923,53588,9155,309,31231,41986,272,587,391,75044,13,27430,1494,23741,87295,6160,62986,79886,18205,296,7040,276,824,15790,276,294,664,3178,45356,56152,72,43327,39934,42249,564,19432,1494,23741,13,362,12407,53661,32923,7893,587,18205,41986,2004,19571,9964,13,8560,300,41986,11203,276,13,2582,526,513,4781,332,23741,656,19818,1043,12874,50707,9964,63190,266,5347,65,12825,11,13080,887,587,1975,36378,1216,482,11163,1216,4864,1048,8826,61515,5347,65,12825,8826,50707,9964,8474,13,473,12825,84,1975,426,28824,15342,52016,77,25041,87295,13080,18608,12776,9379,258,477,18608,35334,824,15790,276,2004,61693,11,1120,87295,18608,96890,30493,10109,10426,9155,309,9964,13],"tokens":["536f","206a","616e67616e","6c6168","206275","6174","206d","756b61","20736564","6579","206a65","206465","70616e","206f72616e67","2073616b","6974","207475","206b616e","2e2e2e","203a2d29","204e","616e67","6973","2070756e","206b616c","6175","20626f","6c6568","206a","616e67616e","21","205468656e","2073656d","616c616d","207075","6173","206a7567","616b","6c6168","206e616b","2070","756a","756b","20656e63","696b","20616269","20737570","617961","206a","616e67616e","20736564","6579","202d","20736564","6579","2074617069","2074616b","206d","616b616e","2070","756a","756b","2e","2054616b","20746175","20646168","206d6163","616d","206d616e61","206e616b","2063","616b","6170","206c616769","2e","20537564","6168","6e7961","20616b75","206269","61726b616e","2073616a61","20646961","206d","656c6179","616e","20706572","617361","616e","2064","7564","756b","206b6174","20746570","