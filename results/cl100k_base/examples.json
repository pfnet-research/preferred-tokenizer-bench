a nwere nnukwu anya. Ọ gaghị ekwe omume ikwu nke agbụrụ Adar bụ n'oge nkenke oge anyị na-ahụ ihu ya, naanị na ọ bụ icha mmirimmiri na kama ogologo ntutu isi ojii. Mana ọ dị ka ihe doro anya na ma ọ bụ mmadụ ma ọ bụ ụdị elf rụrụ arụ, ọ bụghị onye orc.","token_ids":[45,6,10333,648,11,20877,277,49383,297,5794,6181,308,441,477,4942,4415,389,9188,264,294,37028,8019,25877,293,51583,4415,1676,2159,404,4415,220,42703,83,51583,83,51583,15953,37028,220,42703,89,42703,77892,15953,37028,264,61419,42703,331,21336,308,6,540,7404,2467,277,4415,5773,1557,7643,264,4317,13835,308,52898,602,441,220,37028,65,51583,5509,66565,220,42703,89,42703,83377,328,4202,263,13,220,5080,234,4415,58493,51583,6455,220,42703,81,51583,602,441,308,6,37028,64685,11120,3178,66565,4272,86,42703,74,51583,308,441,220,42703,86,5169,9653,21336,294,37028,308,6,564,79,21585,453,64,342,5763,68,4987,8329,4415,19185,40493,1536,6132,308,2629,9653,329,51583,220,42703,293,51583,4355,4415,12,12748,308,6,51583,89,42703,13835,13,5884,37028,308,52898,602,441,220,42703,342,34856,37028,71862,308,96428,264,308,6,82984,220,42703,4317,11,31231,220,42703,294,37028,16909,602,383,294,18812,904,64,4415,220,42703,293,51583,389,9188,220,42703,73,42703,42703,11,379,3444,389,9188,308,52898,220,51583,67,37028,220,42703,81,51583,342,25062,220,42703,331,37028,331,37028,81,37028,308,441,264,4415,12,1247,79,773,383,52253,71,37028,627,44,70,1395,10221,42703,296,9701,391,51583,945,65,391,51583,342,613,5169,308,441,220,42703,1764,11,264,294,42703,49595,51583,81,51583,1676,2159,404,342,5418,2467,277,11,31231,4415,276,37028,32512,587,37028,81,37028,32512,587,37028,81,37028,602,383,904,37028,305,51583,81,51583,342,18275,5169,220,80923,51583,220,42703,70,51583,70,51583,264,16909,308,52898,11120,3178,66565,904,64,13,220,5080,234,342,34856,37028,27955,906,8019,3972,13665,66565,308,441,945,65,51583,81,51583,2467,277,293,51583,308,6,41632,308,2779,441,297,713,904,37028,4415,12,1494,51583,13608,84,13835,11,4415,276,37028,4415,220,42703,293,51583,10864