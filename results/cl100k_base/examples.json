ɗowal haa ngol yiɗa fooɗtaade (walla rentude), ɗam caasam wiyatee liriwam.\nGostol caase : en njiyii fannuuji caasam keewɗi. En njoofiinooma wonnde caasam ina hattani iwde ngonka wona e ngonka ngoɗka, en mbiyiino wonnde ko ɗum huunde mawnde.","token_ids":[23389,521,26351,72,906,551,2211,521,26351,278,15593,220,133,241,324,451,93480,2159,404,451,384,342,980,278,26351,799,11,220,133,245,68,7933,276,303,84,12,133,245,268,3937,64,5676,15593,304,64,10221,352,69178,68,7933,309,597,1617,3444,829,12273,1037,26351,278,13,13903,2002,568,268,220,133,245,72,133,245,72,551,14751,300,309,308,5697,675,309,384,14751,300,309,1080,728,38181,309,627,23389,300,309,308,5697,675,309,551,14751,300,309,308,5697,675,309,15593,220,133,245,309,26351,773,337,829,370,3893,13,220,130,232,309,32940,72,15593,384,1172,641,486,19923,337,305,31141,29965,46971,133,241,265,5534,998,461,15953,2176,384,282,44957,43441,220,133,245,72,133,245,64,133,241,486,308,5697,85277,79853,39959,13,2100,7205,4355,64,5679,78,13780,10221,3178,74,3893,220,133,241,278,278,11,15593,220,133,245,64,309,2211,300,309,11591,460,7933,278,13,452,5697,85277,79853,597,3893,912,568,365,21336,282,1073,11,2211,300,309,220,133,245,309,38245,1648,460,282,352,451,627,23389,300,309,1080,728,38181,309,551,2211,521,1080,728,72,906,781,363,5418,133,245,68,304,64,15953,2176,130,112,72,11,304,64,2004,133,241,276,3893,342,980,278,13,220,130,232,372,2834,72,220,133,241,1411,451,379,13780,23775,11,274,12806,3893,14531,15593,829,309,43441,13,14751,300,309,3980,133,245,68,503,363,5418,133,245,68,296,5418,311,785,5418,133,245,68,289,16618,295,2176,2211,300,309,220,133,241,5418,130,112,38181,309,11,19972,84,15593,220,133,245,68,282,3893,69034,2159,37478,220,133,241,5418,130,112,278,13,2100,665,220,130,112,7211,3893,908,1098,11,665,1717,109,78,130,112,130,112,3893,7933,337,320,16836,64,384,83810,133,245,83,3893,7933,337,705,94246,278,342,980,278,781,13780,384,88999,337,1080,728,278,13081,133,245,363,278,305,5418,7933,337,62797,133,245,64,15586,133,245