不同年代的記憶拼成同一天。每段話都保留講述者能確認的時間與位置，不確定的地方照樣留下。刊物想做的，是讓讀者看見，一段看似熟悉的交通安排，同時承載了許多不會出現在時刻表上的生活，而那些生活並不需要被整理成同一個答案。","token_ids":[99483,112813,138680,133942,98540,109262,101847,100248,124117,121288,3837,141155,110031,107,119227,102969,99058,118037,98443,110459,125882,98969,98881,1773,101311,69272,94,102411,98389,5373,98611,133545,107849,29653,225,103777,98401,101145,98440,3837,10991,119,127455,99575,98366,98764,100248,106644,102902,99266,69272,94,3837,99238,112374,109434,99116,99070,121073,98657,108662,102179,114951,100167,103152,115,98366,8994,141155,110031,107,105189,98316,141509,99072,136635,118812,98314,18474,94,149944,121288,98468,3837,98317,99074,98612,149944,98412,99029,133491,98714,98708,251,99529,133545,3837,100369,148302,98359,109639,100395,99614,98652,112237,98314,115242,1773,100291,124553,98398,125882,98657,99478,101560,108657,35457,110,98921,3837,100291,113395,98474,101284,99155,122193,110511,99043,106644,3837,98518,99440,98440,99423,98577,98462,101348,100521,98520,1773,106679,98521,109545,3837,121924,98553,107388,98552,98872,100880,98314,80048,120,137821,3837,101540,100720,98516,111266,98787,8994,124117,121288,98430,109434,118221,98318,123939,98347,98430,98533,98942,99801,3837,98361,118221,98318,98657,99034,118177,124553,101380,114,100831,98350,98407,101041,1773,98661,98847,126665,98401,103201,143660,99149,98412,98342,135947,98314,131304,107849,100073,3837,98317,131342,98397,100856,98881,121073,103120,1773,112813,98495,101995,3837,98316,121924,10198,222,98412,98440,123024,3837,101688,105678,109107,99772,100541,3837,98407,106644,99081,134259,98321,28048,109,98362,98317,105656,98347,138316,106644,99336,98470,99184,98827,3837,98396,100028,98827,119394,103628,98547,102212,98350,102870,107030,101615,1773],"tokens":["åľ°æĸ¹","åĪĬçī©","æºĸ","åĤĻ","åģļ","ä¸ĢæľŁ","æ¸¡","èĪ¹","å°Ī","é¡Į","ï¼Į","ç·¨","è¼","¯","æľĢåħĪ","æĶ¶åĪ°","çļĦæĺ¯","ä¸ĢåłĨ","å¾Ī","æ¼Ĥäº®çļĦ","é¢¨","æĻ¯","çħ§","ãĢĤ","çħ§çīĩ","è£","¡","çļĦæ°´","éĿ¢","ãĢģ","å±±","ç·ļ","èĪĩ","é»","ĥ","æĺı","éĥ½","å¾Īå¥½"