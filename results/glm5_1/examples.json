OUP"," BY"," room","\n",")\n","SELECT"," room",","," requested","_duration",","," requests"," FROM"," occupied"," ORDER"," BY"," room",";\n"],"ids_available":true,"boundaries_approximate":false,"piece_format":"native_vocabulary_piece","decoded_text":"-- 同じ部屋の予約時間が重なる組を探す。半開区間として終端が次の開始と一致する場\n-- 合は衝突に含めない。識別子の大小を条件にして同じ組の逆順表示を防ぐ。後半の要\n-- 求時間総和は重複を含むので、実際の占有時間と呼ばない。\n\nCREATE TABLE reservations (id INTEGER PRIMARY KEY, room TEXT, begins INTEGER, ends INTEGER,\n CHECK (begins < ends));\nINSERT INTO reservations VALUES (1,'a',10,20),(2,'a',20,25),(3,'a',18,23),(4,'b',12,16),(5,'a',30,35);\nSELECT a.id AS earlier_id, b.id AS later_id, a.room,\n       MAX(a.begins,b.begins) AS overlap_start,\n       MIN(a.ends,b.ends) AS overlap_end\nFROM reservations AS a\nJOIN reservations AS b\n ON a.room = b.room AND a.id < b.id\n AND a.begins < b.ends AND b.begins < a.ends\nORDER BY a.id,b.id;\n\nWITH occupied AS (\n SELECT room, SUM(ends-begins) AS requested_duration, COUNT(*) AS requests\n FROM reservations GROUP BY room\n)\nSELECT room, requested_duration, requests FROM occupied ORDER BY room;\n","measurement_context":null,"character_measurement":null,"roundtrip_exact":true},{"id":"fineweb-ab-0016","collection":"dataset/fineweb/ab.jsonl","text":"Иԥсҭазаара далҵит 64 шықәса ирҭагылаз ахаҵа. Иара ахәышәтәырҭа дҭашәеит абҵара 5 рзы акоронавирус ицәа иаланы. Изымҩаԥыргоз атерапиа иахьмырԥшкәа, апациент иԥсҭазаара далҵит игәеисра аԥсыҽхара иахҟьаны.\nАҟәа асасааирҭа \"Аиҭар\" ашҭаҿы иаадыртыз амобилтә госпиталь аҟны лыԥсҭазаара далҵит 1940 шықәсазы ииз апациент. Иақәнагаз атерапиа шылзмҩаԥыргозгьы, лыдунеи лыԥсахит лгәеисра аԥсыҽхара иахҟьаны.\nАбыржәтәи аамҭазы Гәдоуҭатәи араионтә хәышәтәырҭа хадаҿы ишьҭоуп 72-ҩык ауааԥсыра, урҭ рахьтә 58-ҩык акоронавирус адиагноз рзышьақәырӷәӷәоуп, рҭагылазаашьа бааԥсуп 19-ҩык, ибжьаратәуп - 20-ҩык.","token_ids":[30057,144,98,2247,152833,136086,127552,129719,152841,9355,220,102636,54154,4552,152815,152877,127604,7587,2184,152833,33233,130690,18638,2