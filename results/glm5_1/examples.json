pasan ti pannakapadisi daydi Presidente Ferdinand Marcos kabayatan ti EDSA People Power Revolution idi Pebrero 22 – 25, 1986 gapu kadagiti adu a panaglabsing ti kalintegan ti tao idi panawen ti Martial Law ken diktadora.","token_ids":[45083,4678,315,39530,31150,304,16439,562,277,9812,8985,61144,142190,220,98546,23,24871,27180,264,393,16,11,99752,12922,84,9446,3272,3591,27973,12297,220,112114,264,595,644,416,9084,264,36343,58441,2257,264,822,276,264,4317,1020,644,8985,10885,1816,8985,17303,336,3376,11,4335,352,55410,1645,2172,27973,12297,220,101175,264,595,644,416,9084,13,30766,276,359,81611,8985,134895,8985,96063,968,53180,826,27973,12297,220,112114,264,595,644,416,9084,13,1084,72,281,1020,585,2143,16439,562,277,8985,21478,275,264,8038,31150,36656,277,343,1020,276,8985,7215,524,11450,276,8985,10885,1816,624,35,585,67,585,17634,2270,8985,342,266,329,92365,304,16439,562,277,8985,5363,2123,3348,142190,61144,220,98546,23,24871,27180,9446,933,50309,454,1899,80565,142190,393,21,100928,33367,13,14380,4422,46868,27973,12297,993,84,264,6124,5364,8985,7215,524,391,22679,70982,142190,15382,332,453,264,8038,8985,61144,15227,2152,7491,585,336,8985,10885,1816,8985,2935,644,9692,47362,526,4076,524,8985,23323,3696,7560,8985,14764,67588,624,29423,30399,524,8985,61144,47362,1036,42,2382,724,685,8985,83379,854,264,17563,50434,276,264,49874,19186,84,329,8985,7215,351,57151,277,27973,12297,933,79,18292,352,142190,80139,142190,35179,396,15744,27973,12297,281,1897,2123,92365,4443,3921,13,451,466,672,8985,281,1020,585,370,68111,352,8985,61144,35179,40871,276,8985,281,1020,585,391,329,13221,1899,8578,134895,91729,65028,73421,352,16211,8985,468,72081,8852,7420,22071,40436,5139,76472,220,99241,1365,220,99446,11,220,100759,21,12922,84,67550,351,12297,993,84,264,7215,351,69747,287,8985,35179,396,15744,8985,259,3441,40436,7215,672,268,8985,70721,7506,48916,294,31447,29698,13],"tokens":["Ti","ĠHouse","Ġof","ĠRepresentatives","Ġket","Ġin","yal","ok","ar","anda","Ġti","ĠCHR","Ġiti","Ġ","201","8","Ġ