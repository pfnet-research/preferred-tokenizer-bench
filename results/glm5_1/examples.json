xact":true},{"id":"fineweb-ug-0107","collection":"dataset/fineweb/ug.jsonl","text":"مازاردا قەبرىدىن باشقا ھېچنىمە يوق بولۇپ، پەلەمپەي ئارقىلىق چوققىسىغا چىققىلى بولىدۇ. مازارنىڭ ئىشىكى شەرققە قارىتىلغان بولۇپ، كەڭلىكى تۆت مېتىر، ئېگىزلىكى سەككىز مېتىر، ئۈستىگە «قۇرئان كەرىم» ئايەتلىرى، ئىككى يېنىغا ئەرەپچە مەدھىيىلەر ئويۇلغان، تاملىرى بىنەپشە،كۆك،ئاق ئۈچ خىل رەڭنى ئاساس قىلغان 26خىل نۇسخىدىكى گېئومېتىرىيىلىك ۋە ئۆسۈملۈك نەقىش چۈشۈرۈلگەن كاھىش بىلەن زىننەتلەنگەن بولۇپ، مازارنى خېلىلا ھەيۋەتلىك تۈسكە كىرگۈزگەن. جەنۇب تەرىپىدە بىر كىچىكرەك قەبرە بولۇپ، تۇغلۇق تۆمۈرخاننىڭ سىڭلىسى دەپنە قىلىنغان دەپ قارىلىدۇ، ئۇمۇ خېلى مۇكەممەل ساقلانغان.","token_ids":[127590,39482,128626,5703,77080,152574,83135,54688,13317,54688,11792,129315,134365,220,152552,152569,127721,141663,10171,152574,72707,128230,27751,72244,152561,66891,68285,86692,152574,8531,152574,10171,66891,152574,14548,8802,99,34864,150925,82869,27398,128160,128230,150925,20025,54688,81111,5703,128160,54688,150718,54688,82869,27751,72244,54688,13317,152561,13,23300,127612,34864,141663,152536,8802,99,54688,32637,54688,30947,54688,51815,152574,133929,27398,152574,77080,34864,54688,132059,8531,151321,27751,72244,152561,66891,68285,86221,152574,152536,82869,30947,54688,39219,152560,14283,23300,152569,132059,11066,68285,8802,99,152569,63278,54688,39482,82869,30947,54688,59427,152574,30947,30947,54688,39482,23300,152569,132059,11066,68285,8802,99,152562,46299,54688,63278,152574,12480,27398,152561,11066,127953,39209,86221,152574,11066,54688,10171,12985,8802,99,132720,152574,14283,82869,11066,54688,68285,8802,99,54688,30947,30947,54688,72707,152569,141663,81111,5703,8802,99,152574,11066,152574,66891,127721,152574,23300,152574,13317,152552,54688,14548,54688,8531,152574,11066,8802,99,129600,152561,8531,151321,68285,39219,49071,82869,11066,54688,27751,54688,11792,152574,66891,32637,152574,68285,30947,152560,30947,68285,127953,127784,8802,99,152562,127721,73735,54688,8531,53353,152574,152536,141663,8802,99,90582,90582,77080,54688,8