null,"roundtrip_exact":true},{"id":"code-ja-0042","collection":"dataset/code/ja.jsonl","text":"-- 同じ部屋の予約時間が重なる組を探す。半開区間として終端が次の開始と一致する場\n-- 合は衝突に含めない。識別子の大小を条件にして同じ組の逆順表示を防ぐ。後半の要\n-- 求時間総和は重複を含むので、実際の占有時間と呼ばない。\n\nCREATE TABLE reservations (id INTEGER PRIMARY KEY, room TEXT, begins INTEGER, ends INTEGER,\n CHECK (begins < ends));\nINSERT INTO reservations VALUES (1,'a',10,20),(2,'a',20,25),(3,'a',18,23),(4,'b',12,16),(5,'a',30,35);\nSELECT a.id AS earlier_id, b.id AS later_id, a.room,\n       MAX(a.begins,b.begins) AS overlap_start,\n       MIN(a.ends,b.ends) AS overlap_end\nFROM reservations AS a\nJOIN reservations AS b\n ON a.room = b.room AND a.id < b.id\n AND a.begins < b.ends AND b.begins < a.ends\nORDER BY a.id,b.id;\n\nWITH occupied AS (\n SELECT room, SUM(ends-begins) AS requested_duration, COUNT(*) AS requests\n FROM reservations GROUP BY room\n)\nSELECT room, requested_duration, requests FROM occupied ORDER BY room;\n","token_ids":[313,107115,98263,150123,15755,148904,131304,28098,98429,136371,132005,29303,99462,17199,1773,99143,111234,98439,112865,129199,134489,99364,28098,98509,15755,111234,98788,19146,101653,53468,115173,198,313,121943,15310,12781,251,99178,19618,99210,60477,127734,1773,137172,123840,98371,15755,101926,29303,99562,19618,38618,136599,132005,15755,101042,149002,99424,29303,98800,132298,1773,109434,99143,15755,98339,198,313,6567,109,224,131304,140794,98327,15310,98429,146792,29303,99210,130992,128054,5373,140024,15755,106440,131304,19146,99927,79474,127734,3407,22540,14353,39842,320,307,30264,37273,12007,11,3054,15750,11,12027,30264,11,10330,30264,345,13635,320,50817,1330,366,10330,1106,12692,12490,39842,14700,320,16,2894,64,516,98668,11,98360,23482,17,2894,64,516,98360,11,99446,23482,18,2894,64,516,99243,11,99619,23482,19,2894,65,516,98886,11,99317,23482,20,2894,64,516,99064,11,100235,317,4858,264,1764,5752,6788,842,11,293,1764,5752,2937,842,11,264,21960,345,981,8333,2877,948,791,1330,8401,948,791,1330,8,5752,27159,4906,345,981,16684,287