  "," node"," ="," parent","[node","]\n","           "," return"," path","[::-","1","]\n","       "," for"," neighbor"," in"," sorted","(graph",".get","(node",","," ())","):\n","           "," if"," neighbor"," not"," in"," parent",":\n","               "," parent","[","neighbor","]"," ="," node","\n","               "," queue",".append","(","neighbor",")\n","   "," return"," None","\n\n","hall"," ="," {\"","desk","\":"," [\"","door","\","," \"","stairs","\"],"," \"","stairs","\":"," [\"","desk","\","," \"","yard","\"]}\n","assert"," route","_to","_exit","(h","all",","," \"","desk","\","," {\"","yard","\"})"," =="," [\"","desk","\","," \"","stairs","\","," \"","yard","\"]\n","assert"," route","_to","_exit","(h","all",","," \"","door","\","," {\"","yard","\"})"," is"," None","\n"],"ids_available":true,"boundaries_approximate":false,"piece_format":"native_vocabulary_piece","decoded_text":"# Choose a shortest sequence of doors through a gallery floor\n# plan. A predecessor table is also the visited set, preventing loops from\n# repeatedly entering the queue. Sorting neighbors establishes a\n# reproducible tie rule. A missing exit returns None, while starting at an\n# exit returns a one-element route.\n\nfrom collections import deque\n\ndef route_to_exit(graph, start, exits):\n    queue = deque([start])\n    parent = {start: None}\n    while queue:\n        node = queue.popleft()\n        if node in exits:\n            path = []\n            while node is not None:\n                path.append(node)\n                node = parent[node]\n            return path[::-1]\n        for neighbor in sorted(graph.get(node, ())):\n            if neighbor not in parent:\n                parent[neighbor] = node\n                queue.append(neighbor)\n    return None\n\nhall = {\"desk\": [\"door\", \"stairs\"], \"stairs\": [\"desk\", \"yard\"]}\nassert route_to_exit(hall, \"desk\", {\"yard\"}) == [\"desk\", \"stairs\", \"yard\"]\nassert route_to_exit(hall, \"door\", {\"yard\"}) is None\n","measurement_context":null,"character_measurement":null,"roundtrip_exact":true},{"id":"code-ja-0025","collection":"dataset/code/ja.jsonl","text":"// 非負の辺重みを持つ小さなグラフで、始点からの最短距離を求める。未到達の距離に\n// は最大整数を使い、加算前にあふれを確認する。探索対象へ実際に到達した辺を検証\n// する実装なので、未到達部分の不正辺を全件検査する用途ではない。\n\npackage main\n\nimport \"fmt\"\n\ntype Edge struct { To int; Cost int }\nfunc cheapestPaths(graph [][]Edge, start int) ([]int, error) {\n    if start < 0 || start >= len(graph) { return nil, fmt.Errorf(\"bad start\") }\n    const infinity = int(^uint(0) >> 1)\n    distance := make([]int, len(graph))\n    used := make([]bool, len(graph))\n    for i := range distance { distance[i] = infinity }\n    distance[start] = 0\n    for range graph {\n        node := -1\n        for i := range graph { if !used[i] && (node < 0 || distance[i] < distance[node]) { node = i } }\n        if node < 0 || distance[node] == infinity { break }\n        used[node] = true\n        for _, edge := range graph[node] {\n            if edge.To < 0 || edge.To >= len(graph) || edge.Cost < 0 { return nil, fmt.Errorf(\"bad edge\") }\n            if edge.Cost <= infinity-distance[node] && distance[node]+edge.Cost < distance[edge.To] {\n                distance[edge.To] = distance[node]+edge.Cost\n            }\n        }\n    }\n    return distance, nil\n}\nfunc main() { result, err := cheapestPaths([][]Edge{{{1, 4}, {2, 9}}, {{2, 2}}, {}}, 0); fmt.Println(result, err) }\n","token_ids":[322,18109,251,252,140487,15755,145603,98429,62576,136643,58236,98380,29600,25690,137486,51152,16147,5373,98788,98428,148243,98430,99329,99755,139161,29303,98624,133646,1773,98859,98344,135700,15755,99755,139161,19618,198,322,220,15310,100320,122670,135944,16570,5373,98431,98849,139843,29380,135049,31881,29303,135947,53468,1773,101115,149458,130070,140024,19618,98344,135700,54582,145603,29303,133912,134605,198,322,220,53468,128999,98770,134446,5373,98859,98344,135700,99130,15755,124717,145603,29303,98402,98578,133912,131437,53468,105721,142294,340