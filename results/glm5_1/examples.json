 jaquiri Barzilai sat jaken yokaparaquïnwa.","token_ids":[22229,67962,274,5059,446,148105,9986,25,1959,52,80,5604,1630,73,1346,15945,38603,309,352,28189,66,359,9078,502,7136,17087,10957,1015,38603,46360,2305,73,5580,30,1959,82,15416,4192,91,20,13,619,454,276,580,67962,34465,38603,5059,446,148105,9986,25,1959,34,672,446,37377,461,19358,7714,38603,19982,580,30027,259,1754,5580,5653,49660,391,31405,15129,11,575,80,5604,5059,46012,19982,580,30027,595,81730,521,71,9908,12583,5653,1079,10408,2305,3376,11,32708,6778,476,3366,59428,391,73,5580,5653,276,580,1630,73,459,46012,57085,91,21,13,575,924,502,3366,289,40701,580,25680,73,5580,37816,541,74,20737,19982,580,277,8250,4076,391,38603,1915,11,19982,580,67962,575,4814,580,17146,38603,23666,5305,3016,8655,9986,11,281,610,6595,15842,131941,312,148117,3594,11341,3362,11,62027,32217,130376,129461,16211,4116,638,266,391,38603,2305,1959,82,15416,13,47910,61085,1959,87567,5011,72,9986,1959,82,5059,446,148105,9986,57085,91,22,13,94994,1600,5359,73,5580,386,823,72,1455,436,295,51972,46012,575,4616,73,5580,40599,9986,2804,71,4076,2689,6,96522,3427,5059,446,37377,3376,11,575,3829,72,12279,16211,276,88935,391,5059,446,148105,9986,11,15842,131941,312,148117,678,331,2151,5059,46012,11,296,2305,595,965,3362,16024,10406,12279,16211,1121,72,11,502,454,1121,72,46360,391,38603,266,391,10957,20159,4192,91,23,13,547,25160,10756,431,449,6595,51972,46012,575,924,502,3366,281,5559,88935,140714,129623,8250,3850,352,5059,446,148105,9986,11,362,5580,51972,46012,575,924,4116,1065,1319,1387,18292,11,272,672,446,37377,1247,38603,15842,131941,312,88,275,580,289,672,610,4616,352,3376,575,924,11,575,3829,72,1644,1645,72,575,80,5604,5059,46012,386,823,72,1455,436,295,7578,2305,79,38603,15129,9986,13,547,80,5604,5059,46012,11,8754,370,11,274,459,15842,131941,312,148117,1319,1387,391,1630,73,2410,21982,7578,19358,1915,46012,289,672,610,4616,352,3376,575,924,1319,288,4554,88935,276,580,391,1121,72,272,359,9986,8250,3850,352,266,352,3376,11,575,924,2410,21982,75