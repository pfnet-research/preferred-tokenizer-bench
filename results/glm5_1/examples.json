la rentude), ɗam caasam wiyatee liriwam.\nGostol caase : en njiyii fannuuji caasam keewɗi. En njoofiinooma wonnde caasam ina hattani iwde ngonka wona e ngonka ngoɗka, en mbiyiino wonnde ko ɗum huunde mawnde.","token_ids":[22512,519,25206,72,896,549,2162,519,25206,278,15224,220,153819,324,450,91603,2111,404,450,384,342,965,278,25206,793,11,220,153823,68,7777,276,303,84,12,153823,268,3852,64,5559,15224,304,64,10011,352,67583,68,7777,309,595,1587,3362,822,11998,1021,25206,278,13,13580,1960,566,268,220,133,132032,133,132032,549,14403,300,309,308,5580,672,309,384,14403,300,309,1062,723,36887,309,624,22512,300,309,308,5580,672,309,549,14403,300,309,308,5580,672,309,15224,220,153823,309,25206,768,337,822,370,3808,13,220,153011,309,31706,72,15224,384,1152,638,485,19326,337,135667,28762,45599,153819,265,5419,983,460,15569,2127,384,282,43606,42099,220,133,132032,153823,64,153819,485,308,5580,83483,78123,38651,13,2055,7060,4260,64,5562,78,13463,10011,148269,3808,220,153819,278,278,11,15224,220,153823,64,309,2162,300,309,11333,459,7777,278,13,451,5580,83483,78123,595,3808,902,566,365,20636,282,1055,11,2162,300,309,220,153823,309,36951,1616,459,282,352,450,624,22512,300,309,1062,723,36887,309,549,2162,519,1062,723,72,896,775,363,5305,153823,68,304,64,15569,2127,153050,72,11,304,64,1962,153819,142903,342,965,278,13,220,153011,372,2765,72,220,153819,1386,450,379,13463,22864,11,274,12517,3808,14188,15224,822,309,42099,13,14403,300,309,3893,153823,68,502,363,5305,153823,68,296,5305,311,779,5305,153823,68,289,16206,295,2127,2162,300,309,220,153819,5305,153050,36887,309,11,19371,84,15224,220,153823,68,282,3808,67441,2111,36194,220,153819,5305,153050,278,13,2055,662,220,153050,7066,3808,898,1080,11,662,1683,109,78,153050,153050,3808,7777,337,320,16417,64,384,82026,153823,136257,7777,337,701,92365,278,342,965,278,775,13463,384,87171,337,1062,723,278,12783,153823,363,278,305,5305,7777,337,61264,153823,64,15217,153823,2565,1021,320,16417,64,8015,793,701,220,153823,309,2162,300,309,289,162