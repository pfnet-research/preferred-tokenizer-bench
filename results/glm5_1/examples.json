ized"," hash"," iteration",".\n\n","use"," std","::","collections","::","B","Tree","Map",";\n\n","fn"," grouped","_counts","<'","a",">(","items",":"," &'","a"," [","(&","'","a"," str",","," u","32",")])"," ->"," B","Tree","Map","<&","'","a"," str",","," u","64",">"," {\n","   "," let"," mut"," totals"," ="," B","Tree","Map","::","new","();\n","   "," for"," &(","key",","," count",")"," in"," items"," {\n","       "," *","totals",".entry","(key",").","or","_insert","(","0",")"," +="," u","64","::","from","(count",");\n","   "," }\n","   "," totals","\n","}\n","fn"," above","_limit","<'","a",">(","counts",":"," &","B","Tree","Map","<&","'","a"," str",","," u","64",">,"," limit",":"," u","64",")"," ->"," Vec","<","(&","'","a"," str",","," u","64",")>"," {\n","   "," counts",".iter","().","filter","_map","(|","(&","key",","," &","value",")|"," {\n","       "," if"," value"," >"," limit"," {"," Some","((","key",","," value","))"," }"," else"," {"," None"," }\n","   "," }).","collect","()\n","}\n","fn"," main","()"," {\n","   "," let"," rows"," ="," [(\"","c","opper","\","," ","3","),"," (\"","z","inc","\","," ","0","),"," (\"","c","opper","\","," ","5",")];\n","   "," let"," counts"," ="," grouped","_counts","(&","rows",");\n","   "," assert","_eq","!(","counts","[\"","c","opper","\"],"," ","8",");\n","   "," assert","_eq","!(","above","_limit","(&","counts",","," ","4","),"," vec","![","(\"","c","opper","\","," ","8",")]);\n","   "," assert","!(","group","ed","_counts","(&","[]",").","is","_empty","());\n","   "," println","!(\"{",":","?}\","," counts",");\n","}\n"],"ids_available":true,"boundaries_approximate":false,"piece_format":"native_vocabulary_piece","decoded_text":"// Count metal components in sorted key order. Converting each\n// quantity to a wider integer type before aggregation avoids a narrow per-\n// entry sum. Filtering above a threshold borrows the completed map and\n// leaves it unchanged. Map order is deterministic and does not depend on\n// randomized hash iteration.\n\nuse std::collections::BTreeMap;\n\nfn grouped_counts<'a>(items: &'a [(&'a str, u32)]) -> BTreeMap<&'a str, u64> {\n    let mut totals = BTreeMap::new();\n    for &(key, count) in items {\n        *totals.entry(key).or_insert(0) += u64::from(count);\n    }\n    totals\n}\nfn above_limit<'a>(counts: &BTreeMap<&'a str, u64>, limit: u64) -> Vec<(&'a str, u64)> {\n    counts.iter().filter_map(|(&key, &value)| {\n        if value > limit { Some((key, value)) } else { None }\n    }).collect()\n}\nfn main() {\n    let rows = [(\"copper\", 3), (\"zinc\", 0), (\"copper\", 5)];\n    let counts = grouped_counts(&rows);\n    assert_eq!(counts[\"copper\"], 8);\n    assert_eq!(above_limit(&counts, 4), vec![(\"copper\", 8)]);\n    assert!(grouped_counts(&[]).is_empty());\n    println!(\"{:?}\", counts);\n}\n","measurement_context":null,"character_measurement":null,"roundtrip_exact":true},{"id":"code-en-0003","collection":"dataset/code/en.jsonl","text":"# Choose a shortest sequence of doors through a gallery floor\n# plan. A predecessor table is also the visited set, preventing loops from\n# repeatedly entering the queue. Sorting neighbors establishes a\n# reproducible tie rule. A missing exit returns None, while starting at an\n# exit returns a one-element route.\n\nfrom collections import deque\n\ndef route_to_exit(graph, start, exits):\n    queue = deque([start])\n    parent = {start: None}\n    while queue:\n        node = queue.popleft()\n        if node in exits:\n            path = []\n            while node is not None:\n                path.append(node)\n                node = parent[node]\n            return path[::-1]\n        for neighbor in sorted(graph.get(node, ())):\n            if neighbor not in parent:\n                parent[neighbor] = node\n                queue.append(neighbor)\n    return None\n\nhall = {\"desk\": [\"door\", \"stairs\"], \"stairs\": [\"desk\", \"yard\"]}\nassert route_to_exit(hall, \"desk\", {\"yard\"}) == [\"desk\", \"stairs\", \"yard\"]\nassert route_to_exit(hall, \"door\", {\"yard\"}) is None\n","token_ids":[2,22146,264,38932,8499,315,14029,1526,264,18018,6422,198,2,3119,13,362,38962,1965,374,1083,279,11988,738,11,26079,29639,504,198,2,18789,16248,279,7177,13,76529,18676,63111,264,198,2,52376,77657,18103,5912,13,362,7402,4869,4675,2240,11,1393,5916,518,458,198,2,4869,4675,264,825,28352,6021,382,1499,15290,1159,41713,271,750,6021,2346,16861,24242,11,1191,11,41848,982,262,7177,284,41713,2561,2468,2546,262,2681,284,314,2468,25,2240,532,262,1393,7177,510,286,2436,284,7177,556,75645,741,286,421,2436,304,41848,510,310,1815,284,4167,310,1393,2436,374,537,2240,510,394,1815,2057,6958,340,394,2436,284,2681,29781,921,310,470,1815,61718,16,921,286,369,9561,304,10610,24242,670,6958,11,44223,982,310,421,9561,537,304,2681,510,394,2681,58,36284,60,284,2436,198,394,7177,2057,7,36284,340,262,470,2240,271,42000,284,5212,49747,788,4383,10782,497,330,30017,7914,330,30017,788,4383,49747,497,330,17405,91239,2207,6021,2346,16861,3203,541,11,330,49747,497,5212,17405,79509,621,4383,49747,497,330,30017,497,330,17405,7026,2207,6021,2346,16861,3203,541,11,330,10782,497,5212,17405,79509,374,2240,198],"tokens":["#","ĠChoose","Ġa","Ġshortest","Ġsequence","Ġof","Ġdoors","Ġthrough","Ġa","Ġgallery","Ġfloor","Ċ","#","Ġplan",".","ĠA","Ġpredecessor","Ġtable","Ġis","Ġalso","Ġthe","Ġvisited","Ġset",",","Ġpreventing","Ġloops","Ġfrom","Ċ","#","Ġrepeatedly","Ġentering","Ġthe","Ġqueue",".","ĠSorting","Ġneighbors","Ġestablishes","Ġa","Ċ","#","Ġrepro","ducible","Ġtie","Ġrule",".","ĠA","Ġmissing","Ġexit","Ġreturns","ĠNone",",","Ġwhile","Ġstarting","Ġat","Ġan","Ċ","#","Ġexit","Ġreturns","Ġa","Ġone","-element","Ġroute",".ĊĊ","from","Ġcollections","Ġimport","Ġdeque","ĊĊ","def","Ġroute","_to","_exit","(graph",",","Ġstart",",","Ġexits","):Ċ","ĠĠĠ","Ġqueue","Ġ=","Ġdeque","([","start","])Ċ","ĠĠĠ","Ġparent","Ġ=","Ġ{","start",":","ĠNone","}Ċ","ĠĠĠ","Ġwhile","Ġqueue",":Ċ","ĠĠĠĠĠĠĠ","Ġnode","Ġ=","Ġqueue",".p","opleft","()Ċ","ĠĠĠĠĠĠĠ","Ġi