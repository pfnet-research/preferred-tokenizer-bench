"�","�","�","�","�","�","�","�","�","�","�","�","�","?"],"ids_available":true,"boundaries_approximate":false,"piece_format":"native_vocabulary_piece","decoded_text":"ᏥᎪ ᎢᎾᏓᏅᏖᎭ ᏂᎦᎥ ᎩᏂᏂᎦᏂᏳ ᎨᏒᎢ, ᎠᎴ ᎩᏂᏍᏕᎵᏍᎩ ᎨᏒ ᎢᏗᏢ ᏫᎾᏓᎾᏫ- ᏍᏙᏗᎭ ᎡᎩᏂᏍᏕᎸᏗᏱ ᎠᎴ ᎡᎩᎾᎵᏂᎪᎯᏍᏙᏗᏱ? ᏥᎪ ᎾᏍᎩ ᎡᎲ ᎩᎾᏛᎿᏗᏍᏗ? ᎾᏍᎩᏉᏍᎪ ᎤᏩᏒ ᏂᎦᎥ ᎡᏂᏰᎸᎢ ᎢᎩ? ᎠᎴ ᏗᎩᏂᏲᎱᏒᎯ ᎨᏒᎢ ᎿᏉᏍᎪ ᏔᎵᏁ ᎢᏁᎭ? ᏍᎩᎪᎵᏰᎯ ᎯᎠ ᏥᎪᏪᎸᎦ ᎤᏲ ᎢᏣᏛᎿᏕᎩ ᏱᎩ, ᎤᏅᏗ ᎦᏃᏗᏍᎩ ᎤᏪᏥ ᎠᏛ ᎾᏍᏉ ᎤᏲ ᎢᏳᏛᎿᏕᎩ ᎨᏒᎩ; ᎠᎴ ᎤᏲᏉ ᎢᏳᎾᏛᎿᏕᎩ ᎤᏁᏥ ᎨᏒᎩ. ᎾᏍᎩ ᎯᎠ ᏄᏍᏛ ᎾᏍᎩ ᏕᏍᏓᏤWᎦ. ᎠᏎᏃ ᎾᏍᎩ ᎦᎶᏁᏛ ᏄᏍᏛ ᎤᎴᏂᏤᎸᎢ ᎾᏍᎩᏯ ᎤᎴᏂᏙᎸᎢ ᎾᏍᏉᏍᎪ ᏂᎯ ᎾᏍᎩ ᏂᎤᏍᏗ ᏕᏍᏓᏤᎳᎬᎢ? ᏥᎪ ᎤᏣᏔᏅᎯ ᏤᎿᎢᏳ ᏂᎤᎵᏍᏔᏅ ᏦᎯᏳᏒᎢ? ᏥᎪ ᎡᏣᏛᏅ- ᎢᏍᏓᏁᎸᎯᏉ ᎢᎩ ᏣᎵᏍᏚᎶᏗ?","measurement_context":null,"character_measurement":null,"roundtrip_exact":true},{"id":"fineweb-chr-0032","collection":"dataset/fineweb/chr.jsonl","text":"ᎾᏍᎩ ᎦᎸᏉᏙᏗ ᎨᏎᏍᏗ ᏂᎪᎯᎸ ᎠᎴ ᏂᎪᎯᎸᎢ, ᎡᎺᏅ. 19 ᎩᏲᎵᎸᎭ ᏈᏍᎦ ᎠᎴ ᎡᏈᎳ, ᎠᎴ ᎣᏁᏏᏉᎳ ᏚᏓᏘᏅᎥᎢ. 20 ᎢᎳᏍᏓ ᎪᎴᏂᏗ ᏓᏳᏗᎩᏴᎩ, ᏠᏆᎹᏍᎩᏂ ᎹᎵᏓ ᏓᏥᏯᎧᎯᏴᎩ ᎤᏢᎩ. 21 ᎭᏟᏂᎬᏁᎸᎭ ᎠᏂ ᏣᎷᎯᏍᏗᏱ ᎠᏏᏉ ᎪᎳ ᏂᎨᏒᎾ. ᏳᏇᎳ ᏫᏣᏲᎵᎦ, ᎠᎴ ᎾᏍᏉ ᏇᏗᏂ, ᎠᎴ ᎳᎾᏏ, ᎠᎴ ᏠᏗᏯ, ᎠᎴ ᎾᏂᎥ ᎠᎾᎵᏅᏟ. 22 ᎤᎬᏫᏳᎯ ᏥᏌ ᎦᎶᏁᏛ ᏓᎧᎿᏩᏗᏙᎮᏍᏗ ᏩᏓᏅᏙ. ᎤᏓᏙᎵᏍᏗ ᎨᏒ ᏕᏣᎧᎿᏩᏗᏙᎮᏍᏗ. ᎡᎺᏅ.","token_ids":[157,236,122,157,237,235,157,236,102,85379,236,99,157,236,116,157,237,231,157,237,247,157,237,245,85379,236,101,157,237,236,157,237,235,157,237,245,85379,237,224,157,236,103,157,236,107,157,236,116,85379,236,254,157,236,112,85379,237,224,157,236,103,157,236,107,157,236,116,157,236,95,11,85379,236,94,157,236,118,157,237,227,13,220,98729,85379,236,102,157,237,110,157,236,113,157,236,116,157,236,255,85379,237,230,157,237,235,157,236,99,85379,236,254,157,236,112,85379,236,94,157,237,230,157,236,111,11,85379,236,254,157,236,112,85379,236,96,157,237,223,157,237,237,157,237,231,157,236,111,85379,237,248,157,237,241,157,237,246,157,237,227,157,236,98,157,236,95,13,220,98360,85379,236,95,157,236,111,157,237,235,157,237,241,85379,236,103,157,236,112,157,237,224,157,237,245,85379,237,241,157,237,111,157,237,245,157,236,102,157,237,112,157,236,102,11,85379,237,254,157,237,228,157,236,117,157,237,235,157,236,102,157,237,224,85379,236,117,157,236,113,157,237,241,85379,237,241,157,237,98,157,237,107,157,236,100,157