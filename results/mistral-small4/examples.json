agelse mandag morgen.\nI bedste fald, betyder det vi får afhentet skrald igen mandag.\nI værste fald, betyder det vi må tage fælles ansvar for at undgå at få løst affald til at ligge og flyde i gårdene. Noget der er særlig skidt i forhold til fugle, rotter og andre skadedyr.\nBrug sækkene\nDer er ikke nogen nem løsning på dette problem, men vi har lagt ruller med skraldesække ud ved containerne, som vi beder jer bruge i stedet for at overfylde containerne (fuglene kan komme i åbne containere).","token_ids":[89077,1362,21238,28184,5999,2016,1462,18382,6355,1490,2169,1462,18169,1765,1728,12073,1513,46030,60818,1543,1116,123268,2317,1623,3619,4707,1115,14331,1546,1626,7181,56519,5703,4203,1044,1513,3619,4707,2053,46495,11377,12614,1106,6850,1046,8825,5999,1389,2803,1304,5789,68020,1032,1050,1049,1046,29098,3669,6572,5633,74752,1302,1517,1046,1032,1050,1052,1046,29098,1765,1044,1513,1728,110375,1394,7289,2186,4895,3090,4750,1393,5472,10880,1393,116027,1626,1073,7153,2969,1284,4707,1044,2088,1121,1868,2256,3695,70676,4203,1104,1297,1304,3044,2784,1100,68245,10880,1393,1626,1073,1330,19755,2969,1284,4707,1044,2088,1121,1868,2256,3695,21238,1257,1541,1284,5892,37172,5571,3347,1394,1513,1673,1103,2803,1513,34452,39141,1314,3619,4707,5797,1513,7215,1643,3669,16223,1558,1623,62529,2454,1101,1046,82190,1304,1728,1765,62026,85432,3044,1327,1116,1623,88956,5797,32710,1282,1044,6554,1397,3669,30389,3044,20848,6345,1626,1066,5057,62026,13775,2509,1010,9565,1765,19995,1308,4985,8357,39141,1115,2588,5789,36369,4127,1044,2835,3695,5999,10983,1116,1382,2038,1258,2417,3044,2784,6078,122366,10519,12073,11024,1546,1044,2745,3695,1289,4327,31139,19259,1643,1623,119184,1394,1513,2136,81120,53011,11024,1546,1319,1102,1936,64235,9008,100071,1623,7611,1098,1546,4231,1441,1577],"tokens":["Som","ĠI","ĠmÃ¥","ske","Ġhar","Ġset","Ġ-","Ġeller","Ġsn","art","Ġser","Ġ-","ĠsÃ¥","Ġer","Ġder","Ġved","Ġat","ĠvÃ¦re","Ġfy","ld","t","Ġgodt","Ġop","Ġi","Ġaff","ald","s","container","ne",".Ċ","Det","Ġkommer","Ġ