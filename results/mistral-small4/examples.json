a un novesta līdz avārijas stāvoklim.","token_ids":[1049,1055,1052,1053,1046,54017,6690,1111,23433,1264,128292,5142,2381,27786,126633,26829,81916,1263,68179,115546,2073,94226,1279,4547,43748,3394,2940,4447,11176,53057,67616,4547,6519,1398,1046,7344,13247,1044,111074,15511,1317,1283,4842,2922,126633,26829,4467,53137,1258,1804,1416,2575,7344,13247,1046,1032,1049,1055,1057,1053,1046,54017,1283,2386,22821,20585,4547,1887,1329,5850,3505,2922,1407,14392,7701,54780,1044,1032,1049,1056,1048,1054,1046,54017,16869,15581,4547,6519,1507,6565,1449,1647,1044,2088,1836,1032,1049,1056,1048,1056,1046,84801,1032,1049,1056,1053,1048,1046,34187,1325,2065,3742,1457,27030,1314,5850,3096,1461,4144,7701,5136,10007,51219,79572,1046,1464,38068,1325,21852,71453,20585,1288,1635,1283,2386,2546,1288,128292,5142,2381,5850,38108,4589,1257,29437,1836,1032,1049,1057,1048,1057,1046,53784,1044,18122,102853,2767,4547,3173,116534,11378,1991,1104,16945,1831,26381,1329,42699,128292,5142,2381,1403,4547,1626,1080,71134,1032,1049,1046,38236,4544,98630,1044,1283,2386,2546,4547,61621,4961,93732,3659,1374,1564,107448,40382,3096,4238,5850,1099,49202,109756,4547,5313,1274,8547,4829,37198,49202,1887,1329,5850,1099,94132,1429,1082,42669,2245,3871,1390,71134,1032,1050,1046,38236,4544,98630,1283,2386,2546,4547,129400,2809,2922,26381,128498,1662,24448,1374,1044,9503,22086,22245,1279,106293,1686,9655,1822,1997,42669,1457,24329,24448,4547,2940,27613,1697,2401,61030,42669,100096,20907,10095,1118,80766,1046,1032,1056,1048,1046,1343,3139,1283,2386,2546,4547,128292,6453,2795,7701,7173,1513,9799,21852,23019,69878,68179,21852,1887,1329,5850,1099,49202,1429,1082,42669,2245,1034,43615,57318,1046,1390,71134,1032,1049,1057,1057,1049,1046,53784,1283,2386,53991,2767,4547,3173,1943,1182,2166,11541,12746,5693,86375,4606,20585,4547,1044,2088,1560,10095,1107,1314,1360,43748,3586,1264,61030,82704,2464,1836,12746,5693,1274,8146,1044,69720,33816,6492,1044,4961,13188,1336,8547,2083,1457,3764,6492,84801,2078,4547,8098,1288,1389,91773,1662,6