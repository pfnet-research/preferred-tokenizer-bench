domized hash iteration.\n\nuse std::collections::BTreeMap;\n\nfn grouped_counts<'a>(items: &'a [(&'a str, u32)]) -> BTreeMap<&'a str, u64> {\n    let mut totals = BTreeMap::new();\n    for &(key, count) in items {\n        *totals.entry(key).or_insert(0) += u64::from(count);\n    }\n    totals\n}\nfn above_limit<'a>(counts: &BTreeMap<&'a str, u64>, limit: u64) -> Vec<(&'a str, u64)> {\n    counts.iter().filter_map(|(&key, &value)| {\n        if value > limit { Some((key, value)) } else { None }\n    }).collect()\n}\nfn main() {\n    let rows = [(\"copper\", 3), (\"zinc\", 0), (\"copper\", 5)];\n    let counts = grouped_counts(&rows);\n    assert_eq!(counts[\"copper\"], 8);\n    assert_eq!(above_limit(&counts, 4), vec![(\"copper\", 8)]);\n    assert!(grouped_counts(&[]).is_empty());\n    println!(\"{:?}\", counts);\n}\n","token_ids":[1555,8220,8893,7995,1294,25585,3844,3542,1046,2732,89546,2744,1010,1555,18819,1317,1261,25034,15748,2658,3066,38209,77353,1261,15192,1651,15611,1555,10505,4556,1046,32354,1302,4455,1261,13472,11591,8957,1278,11110,6373,1321,1010,1555,15786,1494,43884,1046,12829,3542,1395,86668,1321,3120,1605,4539,1408,1010,1555,31585,16094,35191,1338,3038,5803,2164,117983,2164,1066,15460,5084,1640,28117,43404,78046,61916,1097,8678,11089,1058,126557,1097,1766,9208,1039,1097,2011,1044,1333,1051,1050,1041,8623,4906,1398,15460,5084,1060,1038,1039,1097,2011,1044,1333,1054,1052,1062,1512,1293,2878,5219,108354,1376,1398,15460,5084,2164,3080,2116,1293,1394,97811,3892,1044,4014,1041,1294,7748,1512,1369,1364,38705,2364,73657,16632,1577,1270,75480,1040,1048,1041,5773,1333,1054,1052,2164,5011,43063,1468,1293,1826,1293,108354,1010,2002,28117,4455,58511,61916,1097,8678,12296,1115,1058,1748,1066,15460,5084,1060,1038,1039,1097,2011,1044,1333,1054,1052,24482,6139,1058,1333,1054,1052,1041,4906,35063,1060,9208,1039,1097,2011,1044,1333,1054,1052,49442,1512,1293,24875,71807,3423,16844,21164,60476,9208,3892,1044,1748,3386,38547,1512,1369,1693,2632,3006,6139,1445,7506,4564,389