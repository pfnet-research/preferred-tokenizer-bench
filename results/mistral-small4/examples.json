ar, botën akademike, shoqërinë civile dhe qytetarët.\nTeksa synojmë një Kryeministër konsensual shqiptar, ne me kënaqësi kemi ftuar akademiket, rektorët, profesorët, organizatat shqiptare , jo vetëm që të mbështesin kauzën, por të diskutojmë dhe të biem dakord për kandidatin ideal për këtë pozicion që është pozicioni më i rëndësishëm i shtetit.\nNe besojmë se së bashku mund të shkruajmë historinë dhe të ndryshojmë politikën për mirë në Maqedoninë Veriore. Së bashku me ju dhe Kryeministrin e parë shqiptar.","token_ids":[5240,1421,2146,1044,1504,12089,1346,45974,1044,111932,1268,26372,5606,3846,22138,1257,5190,11285,30322,97810,1044,8509,25452,54820,15385,28936,57988,8002,9172,2631,17951,85024,25296,1416,11285,2664,23985,7919,8509,1283,3326,1763,3099,8509,39678,5694,2631,44055,40569,2631,1044,2173,44055,38914,4106,1639,23019,8913,2631,1044,17951,75709,16415,2403,8509,4721,8979,87163,108221,19470,1277,1044,14988,18493,48976,2150,1044,54771,1113,11285,93259,47261,15666,4367,57261,1277,28174,1626,118385,7839,5925,3659,1109,2631,21750,85024,25296,1416,11285,20854,1647,1830,108221,19470,1277,1044,1504,1639,88878,2302,1113,116015,1409,12109,14972,14020,48976,55468,1044,1344,19616,28174,1044,45586,28174,1044,7080,67379,108221,19470,1667,3897,5552,29138,45974,30299,8509,19879,121293,1264,1259,37764,1122,18493,1044,2173,8509,93799,3659,1109,2631,15666,8509,3499,1356,77298,1619,17951,57988,8002,14905,17951,120686,16305,18419,30299,41129,16305,1290,7929,30322,1623,1382,77171,16415,2140,45974,1623,64881,87163,1626,11993,4639,3659,1109,2631,1412,44055,38914,4106,35039,8509,57546,1649,2146,1109,2631,7204,93259,15666,8509,111932,2621,61139,2631,34587,18493,17951,7689,2631,11922,5682,1113,1286,1263,93259,3711,38062,1046,1335,2631,38914,4106,1639,5365,15666,85024,25296,1416,15306,1324,97810,108221,19470,1277,1046],"tokens":["Pr","and","aj",",","Ġne","Ġvend","os","Ã«m",",","Ġndrys","he","Ġnga","ĠÃ§","do","Ġparti","Ġt","jet","Ã«r","ĠmÃ«","ĠparÃ«",",","ĠtÃ«","Ġmos","Ġzg","jed","him","Ġka