akhasimende ukuxazulula izinkinga ezihlangabezane ne-R & D nokukhiqiza nokunikeza amakhasimende izixazululo ezenziwe ngezifiso ezifanelekela kangcono ukuthuthukiswa kwesikhathi esizayo.\nE-China (Shanghai) International Technology Fair kulo nyaka, i-TIANGEN ayivelanga nje kuphela i-high-throughput othomathikhi ye-nucleic acid extractors kanye ne-auto pipetting workstation kepha nemikhiqizo esebenza kabusha kanye nezinto zokusetshenziswa zohlolo lwe-SARS-COV2, oludonse amabhizinisi asekhaya nakwamanye amazwe e-IVD e-Fair ukuxhumana.","token_ids":[1073,8588,1073,38866,4456,1294,1662,6786,71218,1808,38870,2621,15722,1356,9231,10100,4119,1466,1268,8966,1409,80195,2140,19448,10002,2699,67024,79541,13604,1104,47922,6364,1459,75576,1068,4684,1356,17035,90826,1523,2589,1275,3088,4494,1302,1113,1417,1518,1556,1282,26180,2868,32384,1631,103088,1489,9006,1329,3963,29020,1104,47922,6364,1046,1362,1411,1329,4402,1459,1122,2097,1518,1489,9417,1324,4606,1113,22134,1264,8101,1808,1295,93292,1851,1366,4761,4684,1662,6786,73888,7795,1715,1816,8153,1402,8481,1748,1407,1044,14684,2399,1808,1723,1264,1268,1409,106699,53397,1291,20821,1411,1105,90826,56885,3230,50261,6786,5499,27540,1097,1308,1643,1122,10022,1282,1906,11317,7541,2699,7541,2699,2509,1554,1662,1523,2589,1275,3088,4684,1662,1808,1122,5791,1111,21394,1489,9006,1329,3963,1046,2301,3244,1105,1404,101436,1808,18142,1374,11486,1855,1489,9006,1329,3963,18142,2428,1955,1366,4427,4961,34053,1097,11317,4183,9909,45914,2868,1504,8481,1748,1407,50261,2699,8101,1113,11486,50261,1384,2150,2712,1855,1489,9006,1329,3963,4961,2111,1955,1366,8505,116244,4606,1808,1308,1643,1122,1391,13956,11317,1391,2868,32384,3753,1409,1533,36232,18142,5130,5130,2699,1275,4761,15722,1264,37532,122265,1823,1518,42116,1626,1069,26536,2208,1319,124135,1041,8018,19243,22747,1409,8505,9714,10100,1044,1623,8588,1073,38866,4456,8540,15184,30452,110875,50876,1268,2584,1623,42709,103382,1281,1411,1313,1682,1552,8101,9889,6603,6111,1290,6331,9041,1839,1409,106699,15