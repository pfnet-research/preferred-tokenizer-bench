laha Ilaah, Ruuxa Ilaah mooyaane. 12Laakiin innagu ma aynu helin ruuxa dunida laakiinse Ruuxa Ilaah ka yimid, inaynu garanno waxyaalaha uu Ilaah nimco ahaan inoo siiyey.","token_ids":[1054,1087,2753,1097,1980,1117,2460,1351,1109,2603,1097,1409,4427,1880,7220,1097,11037,4761,7717,2736,16970,11037,1266,9545,12914,1417,1044,111479,12078,8804,22736,88946,2460,1351,1109,2603,1097,102987,1478,14727,1044,1281,1111,8804,22736,88946,2460,1351,1109,2603,1097,1283,2045,1120,3190,102987,1478,14727,1281,1111,22736,11037,4761,1427,6303,1401,8283,7564,1653,6489,1059,1032,1055,2584,10004,1259,45461,1778,4504,1271,1261,4263,1980,1117,1333,3394,1880,7220,1097,2460,1351,1109,2603,1097,1362,2584,1816,1281,1111,1427,4367,1859,1121,3566,1044,1281,1111,1362,2584,1816,21953,3050,5775,1400,1286,8614,64281,1351,1417,1855,1831,2742,122353,1261,3026,1993,1286,1044,1032,1056,22604,1283,2045,1120,3190,102987,1478,14727,8364,3505,1387,2302,8804,1117,7717,1271,1417,80174,1044,8411,42116,1044,1880,4643,7717,1271,1427,3230,36873,1262,1044,1395,86929,7220,1401,2083,1409,10128,8540,4367,1387,97743,1434,23558,5560,1855,1831,6210,1044,1032,1057,2584,10004,1259,1265,3050,4367,60513,1044,1488,2753,4263,9417,8804,1417,1395,17279,1686,7533,1044,1281,1111,8804,1417,15666,6834,1117,1914,4765,1259,1044,1535,1111,8804,85017,1098,5560,23376,3002,7648,1259,1044,1488,2753,14852,70672,8540,1404,4183,47475,4402,1044,1362,2584,1816,6303,1097,1333,1772,4263,1859,1121,3566,11037,4761,1395,9820,1475,2025,1299,1046,1032,1049,1048,1785,1110,1393,1661,1362,2584,1816,6303,1097,1294,1111,40630,3849,7657,5077,3566,16411,2428,1097,1044,8411,42116,1044,16411,2428,1117,1285,2428,47583,6303,1332,3230,1097,59150,1409,5693,1044,2460,1633,1097,59150,4263,1279,13090,4744,1346,1333,1266,3230,1332,93079,1281,1111,1362,2584,1816,1046,1032,1049,1049,1087,1097,42116,1044,23376,3002,15666,72401,3793,6957,1097,7717,1271,8302,20533,59150,4263,4077,8101,7795,1044,7434,2428,1097,1308,58552,11037,1475,4222,3498,31312,2868,1063,1335,3050,1288,12