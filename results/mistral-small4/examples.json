" [\"","des","k","\","," \"","yard","\"]","}\n","assert"," route","_to","_exit","(h","all",","," \"","des","k","\","," {\"","yard","\"","})"," =="," [\"","des","k","\","," \"","stairs","\","," \"","yard","\"]\n","assert"," route","_to","_exit","(h","all",","," \"","door","\","," {\"","yard","\"","})"," is"," None","\n"],"ids_available":true,"boundaries_approximate":false,"piece_format":"native_vocabulary_piece","decoded_text":"# Choose a shortest sequence of doors through a gallery floor\n# plan. A predecessor table is also the visited set, preventing loops from\n# repeatedly entering the queue. Sorting neighbors establishes a\n# reproducible tie rule. A missing exit returns None, while starting at an\n# exit returns a one-element route.\n\nfrom collections import deque\n\ndef route_to_exit(graph, start, exits):\n    queue = deque([start])\n    parent = {start: None}\n    while queue:\n        node = queue.popleft()\n        if node in exits:\n            path = []\n            while node is not None:\n                path.append(node)\n                node = parent[node]\n            return path[::-1]\n        for neighbor in sorted(graph.get(node, ())):\n            if neighbor not in parent:\n                parent[neighbor] = node\n                queue.append(neighbor)\n    return None\n\nhall = {\"desk\": [\"door\", \"stairs\"], \"stairs\": [\"desk\", \"yard\"]}\nassert route_to_exit(hall, \"desk\", {\"yard\"}) == [\"desk\", \"stairs\", \"yard\"]\nassert route_to_exit(hall, \"door\", {\"yard\"}) is None\n","measurement_context":null,"character_measurement":null,"roundtrip_exact":true},{"id":"code-ja-0025","collection":"dataset/code/ja.jsonl","text":"// 非負の辺重みを持つ小さなグラフで、始点からの最短距離を求める。未到達の距離に\n// は最大整数を使い、加算前にあふれを確認する。探索対象へ実際に到達した辺を検証\n// する実装なので、未到達部分の不正辺を全件検査する用途ではない。\n\npackage main\n\nimport \"fmt\"\n\ntype Edge struct { To int; Cost int }\nfunc cheapestPaths(graph [][]Edge, start int) ([]int, error) {\n    if start < 0 || start >= len(graph) { return nil, fmt.Errorf(\"bad start\") }\n    const infinity = int(^uint(0) >> 1)\n    distance := make([]int, len(graph))\n    used := make([]bool, len(graph))\n    for i := range distance { distance[i] = infinity }\n    distance[start] = 0\n    for range graph {\n        node := -1\n        for i := range graph { if !used[i] && (node < 0 || distance[i] < distance[node]) { node = i } }\n        if node < 0 || distance[node] == infinity { break }\n        used[node] = true\n        for _, edge := range graph[node] {\n            if edge.To < 0 || edge.To >= len(graph) || edge.Cost < 0 { return nil, fmt.Errorf(\"bad edge\") }\n            if edge.Cost <= infinity-distance[node] && distance[node]+edge.Cost < distance[edge.To] {\n                distance[edge.To] = distance[node]+edge.Cost\n            }\n        }\n    }\n    return distance, nil\n}\nfunc main() { result, err := cheapestPaths([][]Edge{{{1, 4}, {2, 9}}, {{2, 2}}, {}}, 0); fmt.Println(result, err) }\n","token_ids":[1555,1032,30372,68182,2439,13667,1186,17867,12925,4187,22265,7706,10684,4928,2768,53189,7461,2701,1749,16540,9079,5120,2439,7695,93671,17368,1157,91313,4187,39627,8440,3670,1320,28985,6016,34269,2439,17368,1157,91313,2650,1010,1555,22616,76086,60896,15627,4187,19885,2393,1749,16224,33767,92918,2657,10948,3010,4187,32390,62930,11780,1320,120016,73291,22949,32661,20066,39199,2650,6016,34269,7086,13667,1186,4187,83777,1156,4986,1188,1010,1555,1032,11780,19212,78828,24129,2701,1749,28985,6016,34269,42687,2439,3163,11429,13667,1186,4187,11039,25109,83777,1156,18709,1187,11780,12600,57979,87196,1355,5502,2830,1267,1917,1429,50276,4410,4994,22649,3449,1445,3870,1935,1059,23987,1935,1826,12127,2176,26411,49213,107475,14573,4344,31173,1044,3030,1935,1041,1319,4344,1594,1044,3880,1041,1512,1293,1693,3030,1534,1032,1048,5159,3030,9218,9027,107475,1041,1445,1850,8843,1044,33486,54452,1796,31094,3030,4428,1826,1293,2018,74116,1376,1935,1040,1094,11646,1040,1048,1041,13890,1032,1049,1456,1293,7786,7485,3180,34573,1594,1