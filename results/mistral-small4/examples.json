а расходов. Слово обсудим скрыло две разные задачи.\nСекретарь разделила их в короткой записи и назвала ответственных за следующий шаг. Решения о работах пока нет. Рядом с каждой задачей она оставила место для ответа. Сосед, предложивший новый план, ещё не взял на себя его подготовку; это нужно было уточнить отдельно. Когда заметку прочитает отсутствовавший сосед, ему не придётся восстанавливать настроение встречи, чтобы понять, что уже можно считать подтверждённым.","token_ids":[17157,16150,24975,1347,34202,9224,108314,11469,91077,3103,5483,40308,1044,7879,2711,1045,11506,22935,43953,2060,1044,1810,2752,21038,57779,44102,24104,11469,1046,4605,20122,3913,57961,68843,121086,41246,1699,1044,48620,2251,19169,58753,1929,19169,10744,1793,1046,2982,1432,10334,120718,104565,97040,3357,26919,5483,6802,127760,1626,5111,10671,1886,15114,1712,5483,50425,2105,15200,1668,78607,19163,89783,1756,21052,27113,50243,53310,2555,108447,26276,1825,1046,19247,27614,1810,27654,1901,19718,38396,1046,4542,20950,2112,1614,113240,41049,49482,18094,1810,104923,26341,7019,46481,1929,1046,22803,46488,1044,44167,1347,38368,70298,31540,1044,34313,2843,45219,1432,1902,29631,9186,66171,4540,1059,11109,54119,12384,2332,2103,24249,3103,34644,21848,1046,66718,123350,4540,4199,32397,2669,70601,22733,38368,126798,1044,28691,2843,59622,75353,39352,117475,2060,25777,117244,5557,35599,3915,1044,20077,43953,3103,1044,5858,23217,28813,41286,3103,87809,99065,8818,1046],"tokens":["ÐĿÐ°","ĠÑģÐ¾Ð±","ÑĢÐ°Ð½Ð¸","Ð¸","ĠÐ´Ð¾Ð¼Ð°","ĠÐ²ÑģÐµ","ĠÑģÐ¾Ð³Ð»Ð°ÑģÐ¸","Ð»Ð¸ÑģÑĮ","ĠÐ¿ÑĢÐ¾Ð´Ð¾Ð»Ð¶Ð¸","ÑĤÑĮ","ĠÑĢÐ°Ð·","Ð³Ð¾Ð²Ð¾ÑĢ",",","ĠÐ½Ð¾","ĠÐ¿Ð¾","-","ÑĢÐ°Ð·","Ð½Ð¾Ð¼Ñĥ","ĠÐ¿Ð¾Ð½Ñı","Ð»Ð¸",",","ĠÐ¾","ĠÑĩ","ÑĳÐ¼","ĠÐ¸Ð¼ÐµÐ½Ð½Ð¾","ĠÐ´Ð¾Ð³","Ð¾Ð²Ð¾ÑĢÐ¸","Ð»Ð¸ÑģÑĮ",".","ĠÐŀ","Ð´Ð½Ð¸","ĠÐ¶","Ð´Ð°Ð»Ð¸","ĠÐ½Ð¾Ð²Ð¾Ð³Ð¾","ĠÐ¿Ð»Ð°Ð½Ð°","ĠÐ´Ð²Ð¾","ÑĢÐ°",",","ĠÐ´ÑĢÑĥÐ³Ð¸Ðµ","ĠâĢĶ","ĠÑĢÐ°Ñģ","ÑĩÑĳ","ÑĤÐ°","ĠÑĢÐ°Ñģ","ÑħÐ¾Ð´","Ð¾Ð²",".","ĠÐ¡","Ð»","Ð¾Ð²Ð¾","ĠÐ¾Ð±ÑģÑĥ","Ð´Ð¸Ð¼","ĠÑģÐºÑĢÑĭ","Ð»Ð¾","ĠÐ´Ð²Ðµ","ĠÑĢÐ°Ð·","Ð½ÑĭÐµ","ĠÐ·Ð°Ð´Ð°ÑĩÐ¸",".