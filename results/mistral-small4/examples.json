" <="," infinity","-distance","[node","]"," &&"," distance","[node","]+","edge",".C","ost"," <"," distance","[","edge",".To","]"," {\n","               "," distance","[","edge",".To","]"," ="," distance","[node","]+","edge",".C","ost","\n","           "," }\n","       "," }\n","   "," }\n","   "," return"," distance",","," nil","\n","}\n","func"," main","()"," {"," result",","," err"," :="," che","apest","Paths","([]","[]","Edge","{{","{","1",","," ","4","},"," {","2",","," ","9","}},"," {{","2",","," ","2","}},"," {","}},"," ","0",");"," fmt",".Println","(result",","," err",")"," }\n"],"ids_available":true,"boundaries_approximate":false,"piece_format":"native_vocabulary_piece","decoded_text":"// 非負の辺重みを持つ小さなグラフで、始点からの最短距離を求める。未到達の距離に\n// は最大整数を使い、加算前にあふれを確認する。探索対象へ実際に到達した辺を検証\n// する実装なので、未到達部分の不正辺を全件検査する用途ではない。\n\npackage main\n\nimport \"fmt\"\n\ntype Edge struct { To int; Cost int }\nfunc cheapestPaths(graph [][]Edge, start int) ([]int, error) {\n    if start < 0 || start >= len(graph) { return nil, fmt.Errorf(\"bad start\") }\n    const infinity = int(^uint(0) >> 1)\n    distance := make([]int, len(graph))\n    used := make([]bool, len(graph))\n    for i := range distance { distance[i] = infinity }\n    distance[start] = 0\n    for range graph {\n        node := -1\n        for i := range graph { if !used[i] && (node < 0 || distance[i] < distance[node]) { node = i } }\n        if node < 0 || distance[node] == infinity { break }\n        used[node] = true\n        for _, edge := range graph[node] {\n            if edge.To < 0 || edge.To >= len(graph) || edge.Cost < 0 { return nil, fmt.Errorf(\"bad edge\") }\n            if edge.Cost <= infinity-distance[node] && distance[node]+edge.Cost < distance[edge.To] {\n                distance[edge.To] = distance[node]+edge.Cost\n            }\n        }\n    }\n    return distance, nil\n}\nfunc main() { result, err := cheapestPaths([][]Edge{{{1, 4}, {2, 9}}, {{2, 2}}, {}}, 0); fmt.Println(result, err) }\n","measurement_context":null,"character_measurement":null,"roundtrip_exact":true},{"id":"code-ja-0042","collection":"dataset/code/ja.jsonl","text":"-- 同じ部屋の予約時間が重なる組を探す。半開区間として終端が次の開始と一致する場\n-- 合は衝突に含めない。識別子の大小を条件にして同じ組の逆順表示を防ぐ。後半の要\n-- 求時間総和は重複を含むので、実際の占有時間と呼ばない。\n\nCREATE TABLE reservations (id INTEGER PRIMARY KEY, room TEXT, begins INTEGER, ends INTEGER,\n CHECK (begins < ends));\nINSERT INTO reservations VALUES (1,'a',10,20),(2,'a',20,25),(3,'a',18,23),(4,'b',12,16),(5,'a',30,35);\nSELECT a.id AS earlier_id, b.id AS later_id, a.room,\n       MAX(a.begins,b.begins) AS overlap_start,\n       MIN(a.ends,b.ends) AS overlap_end\nFROM reservations AS a\nJOIN reservations AS b\n ON a.room = b.room AND a.id < b.id\n AND a.begins < b.ends AND b.begins < a.ends\nORDER BY a.id,b.id;\n\nWITH occupied AS (\n SELECT room, SUM(ends-begins) AS requested_duration, COUNT(*) AS requests\n FROM reservations GROUP BY room\n)\nSELECT room, requested_duration, requests FROM occupied ORDER BY room;\n","token_ids":[1742,1032,73877,11852,42190,2439,46715,16184,19482,3322,17867,20191,22303,4187,120016,4463,1320,27545,11674,24911,8798,21637,22409,83355,3322,58630,33187,2407,3087,57511,11780,10422,1010,1742,1032,10336,2312,5122,1157,21949,2650,61716,8440,10585,1320,15351,1152,27088,8390,2439,5368,10684,4187,17624,25109,2650,5013,73877,22303,2439,74018,11054,1134,36319,4187,42964,32858,1320,91808,2439,10785,1010,1742,84644,1130,19482,36779,4300,2312,17867,93566,127144,17858,2439,2701,1749,39199,2439,73474,4673,19482,20600,8147,10585,1355,48488,33225,89968,1319,1327,66797,87506,35192,1044,5349,57484,1044,19570,66797,1044,15202,66797,1520,71716,1319,63858,2097,1534,15202,3523,35601,33516,89968,41774,1319,1049,11222,1097,2096,1049,1048,1044,1050,1048,62210,1050,11222,1097,2096,1050,1048,1044,1050,1053,62210,1051,11222,1097,2096,1049,1056,1044,1050,1051,62210,1052,11222,1098,2096,1049,1050,1044,1049,1054,62210,1053,11222,1097,2096,1051,1048,1044,1051,1053,1468,12562,1261,5405,10510,9781,3384,1044,1289,5405,10510